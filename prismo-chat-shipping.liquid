<script>
  (function () {
    /* Country-aware shipping answers for the chat widget.
       If a visitor names a country we ship to, reply with the default shipping
       answer PLUS a positive confirmation + PRISMOPRO pitch in the same bubble.
       Countries NOT in the list fall through to the existing generic KB answer
       (we never say "we don't ship to X").
       Entries: "pattern::Display Name". Leading "!" = only match when the
       message also contains a shipping-context word (names like Chad/Jordan). */
    var COUNTRIES = [
      "usa|u\\.s\\.a\\.?|u\\.s\\.|united states|america::the United States",
      "united kingdom|u\\.k\\.|uk|england|britain|scotland|wales::the United Kingdom",
      "united arab emirates|uae|dubai|abu dhabi|emirates::the United Arab Emirates",
      "canada::Canada", "australia::Australia", "new zealand::New Zealand",
      "india::India", "egypt::Egypt", "mexico::Mexico",
      "saudi arabia|saudi|ksa::Saudi Arabia", "qatar::Qatar", "kuwait::Kuwait",
      "bahrain::Bahrain", "oman::Oman", "!jordan::Jordan", "lebanon::Lebanon",
      "israel::Israel", "iraq::Iraq", "yemen::Yemen",
      "morocco::Morocco", "algeria::Algeria", "tunisia::Tunisia", "libya::Libya",
      "south sudan::South Sudan", "sudan::Sudan", "south africa::South Africa",
      "nigeria::Nigeria", "ghana::Ghana", "kenya::Kenya", "ethiopia::Ethiopia",
      "tanzania::Tanzania", "uganda::Uganda", "rwanda::Rwanda", "zambia::Zambia",
      "zimbabwe::Zimbabwe", "botswana::Botswana", "namibia::Namibia",
      "mozambique::Mozambique", "madagascar::Madagascar", "mauritius::Mauritius",
      "seychelles::Seychelles", "senegal::Senegal", "cameroon::Cameroon",
      "cote d.ivoire|ivory coast::Côte d'Ivoire", "angola::Angola",
      "benin::Benin", "burkina faso::Burkina Faso", "burundi::Burundi",
      "cape verde|cabo verde::Cape Verde", "!chad::Chad", "comoros::Comoros",
      "congo::the Congo", "djibouti::Djibouti",
      "equatorial guinea::Equatorial Guinea",
      "guinea.bissau|guinea bissau::Guinea-Bissau",
      "papua new guinea::Papua New Guinea", "guinea::Guinea",
      "eritrea::Eritrea", "eswatini|swaziland::Eswatini", "gabon::Gabon",
      "gambia::Gambia", "lesotho::Lesotho", "liberia::Liberia",
      "malawi::Malawi", "mali::Mali", "mauritania::Mauritania", "niger::Niger",
      "sierra leone::Sierra Leone", "somalia::Somalia", "togo::Togo",
      "turkey|turkiye::Turkey", "cyprus::Cyprus", "greece::Greece",
      "italy::Italy", "spain::Spain", "portugal::Portugal", "france::France",
      "germany::Germany", "austria::Austria", "switzerland::Switzerland",
      "belgium::Belgium", "netherlands|holland::the Netherlands",
      "luxembourg::Luxembourg", "ireland::Ireland", "denmark::Denmark",
      "sweden::Sweden", "norway::Norway", "finland::Finland",
      "iceland::Iceland", "poland::Poland",
      "czech republic|czechia|czech::the Czech Republic",
      "slovakia::Slovakia", "slovenia::Slovenia", "hungary::Hungary",
      "romania::Romania", "bulgaria::Bulgaria", "croatia::Croatia",
      "serbia::Serbia", "bosnia::Bosnia and Herzegovina",
      "montenegro::Montenegro", "north macedonia|macedonia::North Macedonia",
      "albania::Albania", "kosovo::Kosovo", "estonia::Estonia",
      "latvia::Latvia", "lithuania::Lithuania", "ukraine::Ukraine",
      "moldova::Moldova", "belarus::Belarus", "!georgia::Georgia",
      "armenia::Armenia", "azerbaijan::Azerbaijan", "kazakhstan::Kazakhstan",
      "uzbekistan::Uzbekistan", "kyrgyzstan::Kyrgyzstan",
      "tajikistan::Tajikistan", "turkmenistan::Turkmenistan",
      "afghanistan::Afghanistan", "pakistan::Pakistan",
      "bangladesh::Bangladesh", "sri lanka::Sri Lanka", "nepal::Nepal",
      "bhutan::Bhutan", "maldives::the Maldives", "myanmar|burma::Myanmar",
      "thailand::Thailand", "vietnam|viet nam::Vietnam", "cambodia::Cambodia",
      "laos::Laos", "malaysia::Malaysia", "singapore::Singapore",
      "philippines::the Philippines", "brunei::Brunei", "hong kong::Hong Kong",
      "macau|macao::Macao", "japan::Japan", "south korea|korea::South Korea",
      "mongolia::Mongolia", "timor::Timor-Leste", "fiji::Fiji",
      "samoa::Samoa", "tonga::Tonga", "vanuatu::Vanuatu",
      "solomon islands::the Solomon Islands", "new caledonia::New Caledonia",
      "french polynesia|tahiti::French Polynesia",
      "brazil|brasil::Brazil", "argentina::Argentina", "chile::Chile",
      "colombia::Colombia", "peru::Peru", "ecuador::Ecuador",
      "bolivia::Bolivia", "paraguay::Paraguay", "uruguay::Uruguay",
      "venezuela::Venezuela", "guyana::Guyana", "suriname::Suriname",
      "french guiana::French Guiana", "costa rica::Costa Rica",
      "panama::Panama", "guatemala::Guatemala", "honduras::Honduras",
      "el salvador::El Salvador", "nicaragua::Nicaragua", "belize::Belize",
      "jamaica::Jamaica", "haiti::Haiti",
      "dominican republic::the Dominican Republic", "dominica::Dominica",
      "bahamas::the Bahamas", "barbados::Barbados",
      "trinidad::Trinidad and Tobago", "aruba::Aruba", "curacao::Curaçao",
      "grenada::Grenada", "saint lucia|st\\.? lucia::Saint Lucia",
      "antigua::Antigua and Barbuda", "cayman::the Cayman Islands",
      "bermuda::Bermuda", "greenland::Greenland"
    ];

    /* Same regex family as the sizing patch — if it's a sizing question, let that patch answer. */
    var SIZING_RX = /\b(siz(e|es|ed|ing)|3\s*m|unitek|espe|hu[\s.-]?friedy|hufriedy|comparab\w*|compatib\w*|equivalen\w*|interchang\w*|fits?|fitment|dimensions?|conversion|crossover)\b/i;
    var CONTEXT_RX = /\b(ship|ships|shipping|shipped|deliver|delivery|deliveries|delivering|send|sending|sent|mail|post|export|order|orders|ordering|buy|purchase|available|availability|status|fee|fees|cost|costs|price|prices|pricing|rate|rates|country|countries|region|location|international|worldwide|abroad|customs)\b/i;
    var NK_RX = /north\s*korea/i;

    function norm(s) {
      s = s.toLowerCase();
      try { s = s.normalize('NFD').replace(/[\u0300-\u036f]/g, ''); } catch (err) {}
      return s;
    }

    function matchCountry(txt) {
      var t = norm(txt);
      if (NK_RX.test(t)) return null;
      /* "South/Latin/Central/North America" is a region, not the USA. */
      t = t.replace(/(south|latin|central|north)\s+america\w*/g, ' ');
      var hasContext = CONTEXT_RX.test(t);
      var shortMsg = t.split(/\s+/).length <= 6;
      for (var i = 0; i < COUNTRIES.length; i++) {
        var entry = COUNTRIES[i];
        var needsContext = entry.charAt(0) === '!';
        if (needsContext) entry = entry.slice(1);
        var parts = entry.split('::');
        var rx = new RegExp('\\b(?:' + parts[0] + ')\\b', 'i');
        if (!rx.test(t)) continue;
        if (needsContext && !hasContext) return null;
        if (!hasContext && !shortMsg) return null;
        return parts[1];
      }
      return null;
    }

    function buildAnswer(name) {
      return 'We ship throughout the US and to most countries. Orders typically process within 2–5 business days. ' +
        'Some regions are excluded due to trade or shipping limits — but good news: it looks like <strong>' + name +
        '</strong> is one of the countries we ship to! 🎉 Feel free to place your order right on our website — ' +
        'shipping for ' + name + ' is calculated at checkout. 💡 And right now, orders over $2,400 ship ' +
        '<strong>FREE</strong> with code <strong>PRISMOPRO</strong>.';
    }

    function escHtml(s) {
      return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }

    function appendMsg(text, who) {
      var msgs = document.getElementById('chatMessages');
      if (!msgs) return;
      var d = document.createElement('div');
      d.className = 'chat-msg ' + who;
      d.innerHTML = who === 'bot'
        ? '<div class="chat-avatar">AI</div><div class="chat-bubble">' + text + '</div>'
        : '<div class="chat-bubble">' + escHtml(text) + '</div>';
      msgs.appendChild(d);
      msgs.scrollTop = msgs.scrollHeight;
    }

    function maybeIntercept(e) {
      var input = document.getElementById('chatInput');
      var msgs = document.getElementById('chatMessages');
      if (!input || !msgs) return;
      var txt = input.value.trim();
      if (!txt || SIZING_RX.test(txt)) return;
      var name = matchCountry(txt);
      if (!name) return;
      e.stopPropagation();
      e.preventDefault();
      appendMsg(txt, 'user');
      input.value = '';
      var td = document.createElement('div');
      td.className = 'chat-msg bot';
      td.innerHTML = '<div class="chat-avatar">AI</div><div class="chat-typing"><span></span><span></span><span></span></div>';
      msgs.appendChild(td);
      msgs.scrollTop = msgs.scrollHeight;
      setTimeout(function () {
        td.remove();
        appendMsg(buildAnswer(name), 'bot');
      }, 900);
    }

    document.addEventListener('click', function (e) {
      var btn = document.getElementById('chatSendBtn');
      if (!btn) return;
      if (e.target === btn || btn.contains(e.target)) maybeIntercept(e);
    }, true);

    document.addEventListener('keydown', function (e) {
      if (e.key !== 'Enter') return;
      var input = document.getElementById('chatInput');
      if (input && e.target === input) maybeIntercept(e);
    }, true);
  })();
</script>
{% schema %}
{
  "name": "Prismo Chat Shipping",
  "settings": [],
  "presets": [{ "name": "Prismo Chat Shipping" }]
}
{% endschema %}

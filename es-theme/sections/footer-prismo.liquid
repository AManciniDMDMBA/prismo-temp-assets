</footer>

<style>
.shopify-section-group-footer-group.prismo-footer-section { display: block !important; }
.prismo-footer {
  --navy-3: #eef1f8;
  --white: #0a1628;
  --gold: #d4900a;
  --purple: #7c3aed;
  --pink: #db2777;
  --text-muted: #5a6f85;
  --text-dim: #8fa3b8;
  --border: rgba(0,0,60,0.09);
  font-family: 'Outfit', sans-serif;
  background: var(--navy-3);
  border-top: 1px solid var(--border);
  padding: 60px 56px 40px;
  margin: 0;
}
.prismo-footer .footer-inner { max-width: 1200px; margin: 0 auto; }
.prismo-footer .footer-top { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr 1fr; gap: 40px; margin-bottom: 44px; }
.prismo-footer .footer-logo { display: flex; align-items: center; gap: 9px; font-family: 'Playfair Display', serif; font-size: 22px; font-weight: 900; background: linear-gradient(135deg, var(--gold), var(--pink), var(--purple)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; margin-bottom: 12px; }
.prismo-footer .footer-tagline { font-size: 14px; color: var(--text-muted); line-height: 1.6; max-width: 310px; margin: 0 0 22px; }
.prismo-footer .footer-socials { display: flex; gap: 10px; }
.prismo-footer .s-icon { width: 36px; height: 36px; border-radius: 10px; background: rgba(0,0,0,0.04); border: 1px solid var(--border); display: flex; align-items: center; justify-content: center; cursor: pointer; transition: all .2s; text-decoration: none; }
.prismo-footer .s-icon:hover { background: rgba(0,0,0,0.09); }
.prismo-footer .s-icon svg { width: 18px; height: 18px; opacity: 1; }
.prismo-footer .footer-col h4 { font-size: 12px; font-weight: 700; letter-spacing: 1.2px; text-transform: uppercase; color: var(--text-dim); margin: 0 0 18px; font-family: inherit; }
.prismo-footer .footer-col ul { list-style: none; margin: 0; padding: 0; }
.prismo-footer .footer-col li { margin-bottom: 11px; }
.prismo-footer .footer-col a { color: rgba(10,22,40,0.5); text-decoration: none; font-size: 14px; transition: color .2s; }
.prismo-footer .footer-col a:hover { color: var(--white); }
.prismo-footer .footer-bottom { border-top: 1px solid var(--border); padding-top: 26px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; }
.prismo-footer .footer-copy { font-size: 13px; color: var(--text-dim); }
.prismo-footer .footer-made { font-size: 13px; color: var(--text-dim); display: flex; align-items: center; gap: 6px; }
.prismo-footer .pay-icons { display: flex; gap: 7px; }
.prismo-footer .pay-icon { background: rgba(0,0,0,0.04); border: 1px solid var(--border); border-radius: 6px; padding: 4px 10px; font-size: 11px; font-weight: 600; color: var(--text-dim); }
@media (max-width: 960px) {
  .prismo-footer .footer-top { grid-template-columns: 1fr 1fr; gap: 28px; }
}
@media (max-width: 640px) {
  .prismo-footer { padding: 48px 22px 36px; }
  .prismo-footer .footer-top { grid-template-columns: 1fr; }
}
</style>

{% endcapture %}{% render 'prismo-es', html: prismo_src %}{% schema %}
{
  "name": "Prismo Footer",
  "class": "prismo-footer-section",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": []
}
{% endschema %}

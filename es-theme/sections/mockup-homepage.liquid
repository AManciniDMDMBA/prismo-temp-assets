<script>
(function () {
  /* ── Crown video banner tilt (mouse follow) ── */
  var card = document.getElementById('crownBannerInner');
  var hero = document.querySelector('.hero');
  var mx = 0, my = 0, tx = 0, ty = 0;
  function lerp(a,b,t){ return a+(b-a)*t; }
  function tilt(){
    mx = lerp(mx,tx,0.065);
    my = lerp(my,ty,0.065);
    if(card) card.style.transform = 'perspective(1000px) rotateY('+(mx*14)+'deg) rotateX('+(-my*9)+'deg)';
    requestAnimationFrame(tilt);
  }
  if(hero){
    hero.addEventListener('mousemove',function(e){
      var r=hero.getBoundingClientRect();
      tx=Math.max(-1,Math.min(1,(e.clientX-r.left-r.width/2)/(r.width/2)));
      ty=Math.max(-1,Math.min(1,(e.clientY-r.top-r.height/2)/(r.height/2)));
    });
    hero.addEventListener('mouseleave',function(){ tx=0; ty=0; });
  }
  tilt();

  /* ── Product image wrapper: mouse parallax (outer wrap only, image float stays on inner) ── */
  var heroWrap = document.getElementById('heroProductWrap');
  if(heroWrap){
    var ipx=0,ipy=0,itx=0,ity=0;
    document.addEventListener('mousemove',function(e){
      itx=(e.clientX/window.innerWidth-0.5)*20;
      ity=(e.clientY/window.innerHeight-0.5)*12;
    });
    (function imgParallax(){
      ipx=lerp(ipx,itx,0.055); ipy=lerp(ipy,ity,0.055);
      heroWrap.style.transform='translateX('+ipx+'px) translateY('+ipy+'px)';
      requestAnimationFrame(imgParallax);
    })();
  }

  /* ── Scroll animations (IntersectionObserver) ── */
  var prefersReducedMotion = window.matchMedia('(prefers-reduced-motion:reduce)').matches;
  if(!prefersReducedMotion){
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(entry){
        if(entry.isIntersecting){
          entry.target.classList.add('visible');
          io.unobserve(entry.target);
        }
      });
    },{ threshold:0.12, rootMargin:'0px 0px -40px 0px' });
    document.querySelectorAll('.aos,.aos-left,.aos-scale').forEach(function(el){ io.observe(el); });
  } else {
    document.querySelectorAll('.aos,.aos-left,.aos-scale').forEach(function(el){
      el.classList.add('visible');
    });
  }

  /* ── Nav shrink on scroll ── */
  var nav = document.querySelector('nav');
  window.addEventListener('scroll',function(){
    if(window.scrollY>60){
      nav.style.padding='10px 56px';
      nav.style.boxShadow='0 2px 20px rgba(0,0,0,0.08)';
    } else {
      nav.style.padding='16px 56px';
      nav.style.boxShadow='none';
    }
  },{ passive:true });
})();

  /* ── 3D Coverflow Testimonial Carousel ── */
  (function(){
    var stage   = document.getElementById('tcStage');
    var dots    = document.querySelectorAll('.cdot');
    var btnPrev = document.querySelector('.cnav-prev');
    var btnNext = document.querySelector('.cnav-next');
    if(!stage) return;

    var cards = Array.from(stage.querySelectorAll('.tc-card'));
    var total = cards.length;
    var cur   = 0;
    var timer = null;
    var INTERVAL = 4000;

    /* slot positions: how each card looks relative to center */
    var slots = [
      { ry:  0,   tz: 0,    tx: 0,    s: 1,    op: 1    },  /* 0 = active center  */
      { ry: -38,  tz:-260,  tx:-310,  s: 0.82, op: 0.72 },  /* -1 left near       */
      { ry: -52,  tz:-460,  tx:-490,  s: 0.62, op: 0.40 },  /* -2 left far        */
      { ry:  52,  tz:-460,  tx: 490,  s: 0.62, op: 0.40 },  /* +2 right far       */
      { ry:  38,  tz:-260,  tx: 310,  s: 0.82, op: 0.72 },  /* +1 right near      */
    ];

    function getSlot(cardIdx){
      var diff = cardIdx - cur;
      /* wrap shortest path */
      if(diff >  Math.floor(total/2)) diff -= total;
      if(diff < -Math.floor(total/2)) diff += total;
      return diff;
    }

    function positionCards(){
      cards.forEach(function(card, i){
        var diff = getSlot(i);
        var sl;
        if     (diff ===  0) sl = slots[0];
        else if(diff === -1) sl = slots[1];
        else if(diff === -2) sl = slots[2];
        else if(diff ===  1) sl = slots[4];
        else if(diff ===  2) sl = slots[3];
        else {
          /* hidden far back */
          sl = { ry: diff > 0 ? 65 : -65, tz: -700, tx: diff > 0 ? 600 : -600, s: 0.2, op: 0 };
        }
        card.style.transform  = 'translateX(calc(-50% + ' + sl.tx + 'px)) translateY(-50%) translateZ(' + sl.tz + 'px) rotateY(' + sl.ry + 'deg) scale(' + sl.s + ')';
        card.style.opacity    = sl.op;
        card.style.zIndex     = 10 - Math.abs(diff);
        card.classList.toggle('tc-active', diff === 0);
        card.style.pointerEvents = diff === 0 ? 'none' : (Math.abs(diff) <= 2 ? 'auto' : 'none');
      });
      dots.forEach(function(d,i){ d.classList.toggle('active', i === cur); });
    }

    function goTo(n){
      cur = ((n % total) + total) % total;
      positionCards();
    }

    function advance(){ goTo(cur + 1); }

    function startTimer(){ timer = setInterval(advance, INTERVAL); }
    function stopTimer(){  clearInterval(timer); timer = null; }
    function restartTimer(){ stopTimer(); startTimer(); }

    /* nav buttons */
    if(btnNext) btnNext.addEventListener('click', function(){ advance(); restartTimer(); });
    if(btnPrev) btnPrev.addEventListener('click', function(){ goTo(cur - 1); restartTimer(); });

    /* dots */
    dots.forEach(function(d, i){
      d.addEventListener('click', function(){ goTo(i); restartTimer(); });
    });

    /* click side card to bring it forward */
    cards.forEach(function(card, i){
      card.addEventListener('click', function(){
        if(i !== cur){ goTo(i); restartTimer(); }
      });
    });

    /* pause only when hovering the nav controls, not the whole stage */
    var controls = document.querySelector('.carousel-controls');
    if(controls){
      controls.addEventListener('mouseenter', stopTimer);
      controls.addEventListener('mouseleave', startTimer);
    }

    /* touch swipe */
    var tsx = 0;
    stage.addEventListener('touchstart', function(e){ tsx = e.touches[0].clientX; stopTimer(); }, {passive:true});
    stage.addEventListener('touchend',   function(e){ var dx = e.changedTouches[0].clientX - tsx; if(Math.abs(dx) > 40){ dx < 0 ? advance() : goTo(cur-1); } startTimer(); }, {passive:true});

    /* kick off */
    positionCards();
    startTimer();
  })();

  /* ══════════════════════════════════════════
     Modal System — Policy popups + Contact
  ══════════════════════════════════════════ */
  (function(){
    /* ── helpers ── */

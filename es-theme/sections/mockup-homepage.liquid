{% capture prismo_src %}<style>

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --navy: #ffffff; --navy-2: #f5f7fc; --navy-3: #eef1f8;
      --white: #0a1628; --off-white: #1a2d45;
      --gold: #d4900a; --gold-deep: #b07000;
      --purple: #7c3aed; --blue: #0284c7;
      --pink: #db2777; --green: #059669;
      --text-muted: #5a6f85; --text-dim: #8fa3b8;
      --border: rgba(0,0,60,0.09);
      --ease-spring: cubic-bezier(0.16,1,0.3,1);
    }
    html { scroll-behavior: smooth; }
    body { font-family:'Outfit',sans-serif; background:#ffffff; color:var(--white); overflow-x:hidden; }

    /* ── ANNOUNCEMENT BAR ── */
    .ann-bar {
      background:linear-gradient(90deg,#4c1d95,#1e3a8a,#4c1d95);
      background-size:200%; animation:ann-slide 6s linear infinite;
      text-align:center; padding:11px 20px;
      font-size:12.5px; font-weight:600; letter-spacing:0.3px; color:#fff;
    }
    @keyframes ann-slide { 0%{background-position:0%} 100%{background-position:200%} }

    /* ── NAV ── */
    nav {
      position:fixed; top:36px; width:100%; z-index:200;
      display:flex; justify-content:space-between; align-items:center;
      padding:16px 56px;
      background:rgba(255,255,255,0.92); backdrop-filter:blur(20px);
      border-bottom:1px solid rgba(0,0,60,0.1);
    }
    .nav-logo {
      display:flex; align-items:center; gap:8px;
      font-family:'Playfair Display',serif; font-size:20px; font-weight:900; letter-spacing:2px;
      background:linear-gradient(135deg,var(--gold) 0%,var(--pink) 60%,var(--purple) 100%);
      -webkit-background-clip:text; -webkit-text-fill-color:transparent;
    }
    .nav-logo img { flex-shrink:0; mix-blend-mode:multiply; }
    .nav-links { display:flex; gap:32px; list-style:none; }
    .nav-links a { color:rgba(10,22,40,0.55); text-decoration:none; font-size:14px; font-weight:500; transition:color .2s; }
    .nav-links a:hover { color:var(--white); }
    .nav-cta {
      background:linear-gradient(135deg,var(--gold),#e8a500);
      color:#fff; font-weight:700; font-size:13.5px;
      padding:10px 22px; border-radius:50px; border:none; cursor:pointer;
      text-decoration:none; transition:transform .2s,box-shadow .2s;
    }
    .nav-cta:hover { transform:translateY(-1px); box-shadow:0 8px 28px rgba(212,144,10,0.4); }

    /* ══ HERO ══ */
    .hero {
      min-height:100vh;
      display:flex; flex-direction:column; align-items:center; justify-content:flex-start;
      padding-top:128px; padding-bottom:0;
      position:relative; overflow:hidden;
    }
    .hero-bg {
      position:absolute; inset:0; pointer-events:none;
      background:
        radial-gradient(ellipse 80% 60% at 70% 40%,rgba(124,58,237,0.07) 0%,transparent 60%),
        radial-gradient(ellipse 60% 80% at 20% 30%,rgba(2,132,199,0.05) 0%,transparent 55%),
        radial-gradient(ellipse 50% 50% at 80% 80%,rgba(219,39,119,0.04) 0%,transparent 50%);
    }
    .hero-grid {
      position:absolute; inset:0; pointer-events:none;
      background-image:linear-gradient(rgba(0,0,60,0.04) 1px,transparent 1px),linear-gradient(90deg,rgba(0,0,60,0.04) 1px,transparent 1px);
      background-size:60px 60px;
      mask-image:radial-gradient(ellipse 80% 80% at 50% 50%,black 20%,transparent 80%);
    }

    /* Floating background orbs */
    .hero-orbs { position:absolute; inset:0; pointer-events:none; overflow:hidden; }
    .orb {
      position:absolute; border-radius:50%;
      filter:blur(60px); opacity:0.18;
      animation:orb-drift 12s ease-in-out infinite;
    }
    .orb-1 { width:320px;height:320px;background:var(--purple);top:-80px;right:10%;animation-delay:0s; }
    .orb-2 { width:240px;height:240px;background:var(--blue);top:30%;right:25%;animation-delay:-4s; }
    .orb-3 { width:280px;height:280px;background:var(--pink);top:10%;right:40%;animation-delay:-8s;opacity:0.10; }
    .orb-4 { width:200px;height:200px;background:var(--gold);top:50%;right:5%;animation-delay:-2s;opacity:0.12; }
    @keyframes orb-drift {
      0%,100% { transform:translateY(0) scale(1); }
      50%      { transform:translateY(-30px) scale(1.08); }
    }

    /* Two-column hero layout */
    .hero-inner {
      position:relative; z-index:2;
      width:100%; max-width:1180px; margin:0 auto;
      padding:0 56px 64px;
      display:grid; grid-template-columns:1fr 1fr; gap:60px; align-items:center;
    }
    .hero-text { text-align:left; }
    .hero-badge {
      display:inline-flex; align-items:center; gap:8px;
      background:rgba(212,144,10,0.08); border:1px solid rgba(212,144,10,0.3);
      border-radius:50px; padding:7px 16px;
      font-size:12px; font-weight:600; color:var(--gold); margin-bottom:28px; letter-spacing:0.5px;
    }
    .hero-badge-dot {
      width:6px;height:6px;border-radius:50%;background:var(--gold);
      box-shadow:0 0 8px var(--gold); animation:dot-pulse 2s ease-in-out infinite;
    }
    @keyframes dot-pulse { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:0.5;transform:scale(0.7)} }

    .hero h1 {
      font-family:'Playfair Display',serif;
      font-size:clamp(46px,5.5vw,76px); font-weight:900; line-height:1.05; margin-bottom:22px;
    }
    .hero h1 .line-plain { display:block; color:var(--white); }
    .hero h1 .line-grad {
      display:block;
      background:linear-gradient(120deg,var(--gold) 0%,var(--pink) 45%,var(--purple) 100%);
      -webkit-background-clip:text; -webkit-text-fill-color:transparent;
    }
    .hero-tagline {
      display:inline-block;
      font-size:13px; font-weight:700; letter-spacing:2px;
      text-transform:uppercase;
      color:var(--purple);
      margin-bottom:16px;
      opacity:0.85;
    }
    .hero-sub { font-size:clamp(15px,1.5vw,17px); color:var(--text-muted); line-height:1.7; max-width:400px; margin-bottom:38px; }
    .hero-btns { display:flex; gap:14px; flex-wrap:wrap; }

    /* ── HERO CROWN VISUAL — real product photo ── */
    .hero-visual {
      display:flex; flex-direction:column; align-items:center; justify-content:center;
      position:relative;
    }
    /* outer wrapper handles the JS mouse parallax */
    .hero-product-wrap {
      width:100%; max-width:480px;
      will-change:transform;
    }
    /* inner img handles the CSS float — separate layer, no conflict */
    .hero-product-img {
      width:100%; display:block;
      animation:img-float 5s ease-in-out infinite;
      will-change:transform;
      /* no border, no frame — white bg blends seamlessly */
    }
    @keyframes img-float {
      0%,100% { transform:translateY(0); }
      50%      { transform:translateY(-14px); }
    }

    /* ── HERO LOGO MARK ── */
    .hero-logo-mark {
      display:inline-flex; align-items:baseline; gap:3px;
      font-family:'Playfair Display',serif;
      font-size:13px; font-weight:700; letter-spacing:1.8px;
      text-transform:uppercase; margin-bottom:18px;
      background:linear-gradient(135deg,var(--gold) 0%,var(--pink) 55%,var(--purple) 100%);
      -webkit-background-clip:text; -webkit-text-fill-color:transparent;
    }
    .hero-logo-mark sup { font-size:8px; font-family:'Outfit',sans-serif; font-weight:700; -webkit-text-fill-color:transparent; }

    /* Hero entrance animations */
    .hero-text > * { animation:text-enter 0.9s var(--ease-spring) both; }
    .hero-text .hero-badge    { animation-delay:.05s; }
    .hero-text h1             { animation-delay:.15s; }
    .hero-text .hero-tagline  { animation-delay:.24s; }
    .hero-text .hero-sub      { animation-delay:.33s; }
    .hero-text .hero-btns     { animation-delay:.42s; }
    @keyframes text-enter {
      from { opacity:0; transform:translateX(-28px); }
      to   { opacity:1; transform:translateX(0); }
    }
    .hero-visual { animation:visual-enter 1.1s var(--ease-spring) both .3s; }
    @keyframes visual-enter {
      from { opacity:0; transform:translateY(32px) scale(0.92); }
      to   { opacity:1; transform:translateY(0) scale(1); }
    }

    /* FULL-WIDTH CROWN BANNER */
    .crown-banner {
      position:relative; z-index:2; width:100%;
      background:#ffffff;
      display:flex; align-items:center; justify-content:center;
      overflow:hidden; height:460px;
      animation:banner-enter 1.1s var(--ease-spring) both .3s;
      border-top:1px solid rgba(0,0,60,0.07);
      border-bottom:1px solid rgba(0,0,60,0.07);
    }
    @keyframes banner-enter {
      from { opacity:0; transform:translateY(24px); }
      to   { opacity:1; transform:translateY(0); }
    }
    .crown-banner::before,.crown-banner::after { display:none; }
    .crown-banner-top-fade { display:none; }
    .crown-banner-bot-fade { display:none; }
    .crown-banner-inner {
      position:relative; height:100%; width:auto;
      display:flex; align-items:center; justify-content:center; overflow:hidden;
    }
    .crown-banner-inner video {
      height:100%; width:auto; display:block;
      transform:scale(0.84) translateY(3%); transform-origin:50% 50%;
    }
    .crown-ticker {
      position:absolute; bottom:0; left:0; right:0; height:19%;
      background:linear-gradient(135deg,#7c3aed 0%,#0284c7 100%);
      z-index:4; overflow:hidden; display:flex; align-items:center;
    }
    .crown-ticker-track {
      display:flex; gap:56px;
      animation:marquee 30s linear infinite; white-space:nowrap; width:max-content;
    }
    .crown-ticker-track:hover { animation-play-state:paused; }
    .crown-ticker-item { display:flex;align-items:center;gap:10px;font-size:13.5px;font-weight:600;color:rgba(255,255,255,0.92);flex-shrink:0; }
    .crown-ticker-item strong { color:#fff; }
    .crown-ticker-dot { width:5px;height:5px;border-radius:50%;background:rgba(255,255,255,0.55);flex-shrink:0; }

    /* ── BUTTONS ── */
    .btn-primary {
      background:linear-gradient(135deg,var(--gold),#e8a500);
      color:#fff; font-weight:700; font-size:15px;
      padding:15px 32px; border-radius:50px; border:none; cursor:pointer;
      text-decoration:none; transition:all .22s;
      box-shadow:0 4px 24px rgba(212,144,10,0.3); font-family:'Outfit',sans-serif;
    }
    .btn-primary:hover { transform:translateY(-2px); box-shadow:0 12px 36px rgba(212,144,10,0.5); }
    .btn-secondary {
      background:transparent; color:var(--white); font-weight:600; font-size:15px;
      padding:15px 32px; border-radius:50px; border:1px solid rgba(10,22,40,0.25);
      cursor:pointer; text-decoration:none; transition:all .22s; font-family:'Outfit',sans-serif;
    }
    .btn-secondary:hover { background:rgba(10,22,40,0.05); border-color:rgba(10,22,40,0.4); }

    /* ── TRUST MARQUEE ── */
    .trust-bar { overflow:hidden; background:var(--navy-3); border-top:1px solid var(--border); border-bottom:1px solid var(--border); padding:16px 0; }
    .trust-track { display:flex;gap:60px;animation:marquee 28s linear infinite;white-space:nowrap;width:max-content; }
    .trust-track:hover { animation-play-state:paused; }
    @keyframes marquee { from{transform:translateX(0)} to{transform:translateX(-50%)} }
    .trust-item { display:flex;align-items:center;gap:10px;font-size:13.5px;font-weight:500;color:var(--text-muted);flex-shrink:0; }
    .trust-item strong { color:var(--white); }
    .trust-dot { width:5px;height:5px;border-radius:50%;background:var(--gold);flex-shrink:0; }

    /* ── SECTIONS ── */
    section { padding:96px 56px; }
    .section-label { font-size:11px;font-weight:700;letter-spacing:2.5px;text-transform:uppercase;color:var(--gold);margin-bottom:14px; }
    .section-title { font-family:'Playfair Display',serif;font-size:clamp(30px,3.6vw,50px);font-weight:900;line-height:1.12;margin-bottom:18px; }
    .section-sub { font-size:17px;color:var(--text-muted);line-height:1.65;max-width:520px; }

    /* ── SCROLL ANIMATIONS ── */
    .aos {
      opacity:0; transform:translateY(28px);
      transition:opacity .7s var(--ease-spring), transform .7s var(--ease-spring);
    }
    .aos.visible { opacity:1; transform:translateY(0); }
    .aos-left  { opacity:0; transform:translateX(-28px); transition:opacity .7s var(--ease-spring), transform .7s var(--ease-spring); }
    .aos-left.visible { opacity:1; transform:translateX(0); }
    .aos-scale { opacity:0; transform:scale(0.93); transition:opacity .6s var(--ease-spring), transform .6s var(--ease-spring); }
    .aos-scale.visible { opacity:1; transform:scale(1); }
    .delay-1 { transition-delay:.07s; }
    .delay-2 { transition-delay:.14s; }
    .delay-3 { transition-delay:.21s; }
    .delay-4 { transition-delay:.28s; }
    .delay-5 { transition-delay:.35s; }
    .delay-6 { transition-delay:.42s; }

    /* ── WHY PRISMO ── */
    .why { background:var(--navy); }
    .why-inner { max-width:1200px; margin:0 auto; }
    .why-header { margin-bottom:56px; }
    .why-grid { display:grid; grid-template-columns:1.2fr 1fr; grid-template-rows:auto auto; gap:20px; }
    .why-card {
      background:var(--navy-2); border:1px solid var(--border); border-radius:20px; padding:40px 36px;
      transition:transform .3s var(--ease-spring), border-color .3s, box-shadow .3s;
    }
    .why-card:hover { transform:translateY(-6px); border-color:rgba(0,0,60,0.18); box-shadow:0 20px 50px rgba(0,0,0,0.06); }
    .why-card.featured {
      grid-row:1/3;
      background:linear-gradient(160deg,rgba(139,92,246,0.12) 0%,rgba(56,189,248,0.06) 100%);
      border-color:rgba(139,92,246,0.2); display:flex; flex-direction:column; justify-content:center;
    }
    .why-icon { width:52px;height:52px;border-radius:14px;display:flex;align-items:center;justify-content:center;margin-bottom:20px; }
    .why-icon svg { width:26px; height:26px; }
    .icon-gold  { background:rgba(212,144,10,0.12); }
    .icon-blue  { background:rgba(2,132,199,0.12); }
    .icon-purple{ background:rgba(124,58,237,0.12); }
    .why-card h3 { font-size:20px;font-weight:700;margin-bottom:12px; }
    .why-card p  { font-size:15px;color:var(--text-muted);line-height:1.65; }
    .why-card.featured .why-big { font-family:'Playfair Display',serif;font-size:58px;font-weight:900;line-height:1;color:var(--gold);margin:16px 0 8px; }
    .why-card.featured .why-big-sub { font-size:14px;color:var(--text-muted); }

    /* ── WINS GRID (inside umbrella) ── */
    .wins-grid {
      display:grid; grid-template-columns:repeat(3,1fr); gap:22px;
      margin-top:0; /* sits flush under the SVG terminal dots */
    }
    .win-card {
      background:rgba(255,255,255,0.72); backdrop-filter:blur(10px);
      border:1px solid rgba(255,255,255,0.65);
      border-radius:20px; padding:32px 28px; text-align:center;
      transition:transform .45s var(--ease-spring), box-shadow .45s;
      will-change:transform;
    }
    /* resting tilt — cards lean in toward the umbrella lines */
    .win-card:nth-child(1) { transform:rotate(-2.5deg) translateY(6px); }
    .win-card:nth-child(2) { transform:translateY(-4px); }
    .win-card:nth-child(3) { transform:rotate(2.5deg) translateY(6px); }
    /* hover — straighten and lift */
    .win-card:nth-child(1):hover { transform:rotate(0deg) translateY(-8px); box-shadow:0 24px 56px rgba(244,114,182,0.15); }
    .win-card:nth-child(2):hover { transform:translateY(-12px);             box-shadow:0 24px 56px rgba(56,189,248,0.15); }
    .win-card:nth-child(3):hover { transform:rotate(0deg) translateY(-8px); box-shadow:0 24px 56px rgba(245,200,66,0.18); }
    .win-icon { width:52px;height:52px;border-radius:14px;display:flex;align-items:center;justify-content:center;margin:0 auto 16px; }
    .win-icon svg { width:26px;height:26px; }
    .win-photo { width:100%;height:170px;border-radius:14px;overflow:hidden;margin-bottom:18px; }
    .win-photo img { width:100%;height:100%;object-fit:cover;object-position:center; }
    .win-stat { font-family:'Playfair Display',serif;font-size:34px;font-weight:900;line-height:1;color:var(--white);margin-bottom:6px; }
    .win-title { font-size:17px;font-weight:700;margin-bottom:10px; }
    .win-desc { font-size:14px;color:var(--text-muted);line-height:1.65; }

    /* ── UMBRELLA ── */
    .umbrella-section {
      position:relative; border-top:1px solid var(--border); border-bottom:1px solid var(--border);
      background:linear-gradient(rgba(255,255,255,0.68),rgba(255,255,255,0.68)),url('https://cdn.shopify.com/s/files/1/0887/0409/0388/files/umbrellas.gif?v=1781034648') center/cover no-repeat;
    }
    .umbrella-inner { max-width:1080px;margin:0 auto;text-align:center; }
    .umbrella-inner .section-sub { margin:0 auto 56px; }
    .umbrella-diagram { position:relative;width:100%;max-width:820px;margin:0 auto; }
    .umbrella-diagram svg { width:100%;height:auto;overflow:visible; }

    /* ── VIDEO ── */
    .video-section { background:linear-gradient(135deg,var(--navy-3) 0%,rgba(139,92,246,0.07) 100%); border-top:1px solid var(--border); }
    .video-inner { max-width:1200px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center; }
    .video-placeholder {
      border-radius:20px;aspect-ratio:16/9;
      background:linear-gradient(135deg,rgba(139,92,246,0.2),rgba(56,189,248,0.15));
      border:1px solid rgba(139,92,246,0.2);
      display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden;
    }
    .video-placeholder::before { content:'';position:absolute;inset:0;background:radial-gradient(ellipse at 50% 50%,rgba(139,92,246,0.15),transparent 70%); }
    .play-btn {
      width:72px;height:72px;border-radius:50%;background:rgba(255,255,255,0.92);
      display:flex;align-items:center;justify-content:center;
      cursor:pointer;transition:transform .2s,box-shadow .2s;position:relative;z-index:1;
    }
    .play-btn:hover { transform:scale(1.1); box-shadow:0 0 40px rgba(255,255,255,0.3); }
    .play-btn svg { margin-left:4px; }
    .video-stats { display:flex;gap:44px;margin-top:40px; }
    .stat-num { font-family:'Playfair Display',serif;font-size:44px;font-weight:900;line-height:1; }
    .stat-num.gold { color:var(--gold); }
    .stat-num.blue { color:var(--blue); }
    .stat-label { font-size:13px;color:var(--text-muted);margin-top:4px; }

    /* ── COMPARISON ── */
    .compare-section { background:var(--navy); }
    .compare-inner { max-width:920px;margin:0 auto;text-align:center; }
    .compare-inner .section-sub { margin:0 auto 52px; }

    /* Comparison table */
    .compare-table { width:100%;border-collapse:collapse;margin-top:56px;border-radius:20px;overflow:hidden;border:1px solid var(--border); }
    .compare-table th { padding:20px 24px;font-size:14px;font-weight:700;letter-spacing:.5px; }
    .compare-table th:first-child { text-align:left;color:var(--text-muted);background:rgba(0,0,60,0.02); }
    .compare-table th.col-silver { background:rgba(0,0,60,0.03);color:var(--text-muted);text-align:center; }
    .compare-table th.col-prismo { background:linear-gradient(135deg,rgba(245,200,66,0.18),rgba(155,93,229,0.12));color:var(--gold);border-left:1px solid rgba(245,200,66,0.25);border-right:1px solid rgba(245,200,66,0.25);text-align:center; }
    .compare-table td { padding:16px 24px;font-size:14px;border-top:1px solid var(--border); }
    .compare-table td:first-child { text-align:left;color:var(--white);background:rgba(0,0,60,0.01);font-weight:500; }
    .compare-table td.col-silver { text-align:center;color:var(--text-muted);background:rgba(0,0,60,0.02); }
    .compare-table td.col-prismo { text-align:center;background:rgba(245,200,66,0.05);border-left:1px solid rgba(245,200,66,0.15);border-right:1px solid rgba(245,200,66,0.15); }
    .compare-table tr:last-child td.col-prismo { border-bottom:1px solid rgba(245,200,66,0.15); }
    .cmp-yes   { color:var(--green);font-weight:700;font-size:16px; }
    .cmp-no    { color:#e05252;font-weight:700;font-size:16px; }
    .cmp-maybe { color:#e05252;font-weight:700;font-size:16px; }

    /* ── COLORS ── */
    .colors-section { background:var(--navy-3);border-top:1px solid var(--border); }
    .colors-inner { max-width:1200px;margin:0 auto; }
    .colors-header { display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:52px; }
    .colors-grid { display:grid;grid-template-columns:repeat(4,1fr);gap:20px; }
    .color-card {
      border-radius:22px;padding:38px 24px;text-align:center;border:1px solid var(--border);
      transition:transform .35s var(--ease-spring),box-shadow .35s,border-color .3s;
      cursor:pointer;position:relative;overflow:hidden;
    }
    .color-card:hover { transform:translateY(-7px); }
    a.color-card { text-decoration:none;color:inherit;display:block; }
    .color-card::before { content:'';position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,rgba(255,255,255,0.18),transparent); }
    .color-card.rainbow-card { background:linear-gradient(160deg,rgba(56,189,248,0.1),rgba(139,92,246,0.1)); }
    .color-card.rainbow-card:hover { box-shadow:0 28px 56px rgba(139,92,246,0.28);border-color:rgba(139,92,246,0.3); }
    .color-card.gold-card { background:linear-gradient(160deg,rgba(245,200,66,0.12),rgba(245,200,66,0.04)); }
    .color-card.gold-card:hover { box-shadow:0 28px 56px rgba(212,144,10,0.22);border-color:rgba(212,144,10,0.3); }
    .color-card.blue-card { background:linear-gradient(160deg,rgba(56,189,248,0.12),rgba(56,189,248,0.04)); }
    .color-card.blue-card:hover { box-shadow:0 28px 56px rgba(56,189,248,0.2);border-color:rgba(56,189,248,0.3); }
    .color-card.purple-card { background:linear-gradient(160deg,rgba(139,92,246,0.14),rgba(139,92,246,0.04)); }
    .color-card.purple-card:hover { box-shadow:0 28px 56px rgba(139,92,246,0.28);border-color:rgba(139,92,246,0.3); }
    .swatch-wrap { width:80px;height:80px;margin:0 auto 20px;border-radius:50%;position:relative;box-shadow:0 6px 24px rgba(0,0,0,0.5),inset 0 1px 0 rgba(255,255,255,0.3); }
    .swatch-wrap::after { content:'';position:absolute;top:12%;left:15%;width:40%;height:30%;border-radius:50%;background:rgba(255,255,255,0.28);filter:blur(4px); }
    .swatch-rainbow { background:conic-gradient(from 180deg,#1d4ed8,#0d9488,#7c3aed,#be185d,#f59e0b,#1d4ed8); animation:hue-spin 4s linear infinite; }
    @keyframes hue-spin { to { filter:hue-rotate(360deg); } }
    .swatch-gold   { background:linear-gradient(135deg,#fef3c7 0%,#f5c842 35%,#b45309 70%,#78350f 100%); }
    .swatch-blue   { background:linear-gradient(135deg,#bfdbfe 0%,#1d4ed8 50%,#1e3a8a 100%); }
    .swatch-purple { background:linear-gradient(135deg,#f5d0fe 0%,#c026d3 45%,#7e1d8c 100%);box-shadow:0 4px 20px rgba(192,38,211,0.55); }
    .color-badge { position:absolute;top:14px;right:14px;background:rgba(255,255,255,0.07);border:1px solid rgba(255,255,255,0.1);border-radius:20px;padding:3px 10px;font-size:10.5px;font-weight:600;color:var(--text-muted); }
    .color-name { font-size:16px;font-weight:700;margin-bottom:5px; }
    .color-desc { font-size:13px;color:var(--text-muted);line-height:1.5; }

    /* ══ GALLERY SECTION ══ */
    .gallery-section { background:var(--navy); border-top:1px solid var(--border); }
    .gallery-inner { max-width:1200px; margin:0 auto; }
    .gallery-header { max-width:600px; margin-bottom:56px; }
    .gallery-grid {
      display:grid; grid-template-columns:repeat(4,1fr);
      gap:18px;
    }
    /* Square media area — same for every card */
    .gc-visual { aspect-ratio:1/1; height:auto !important; width:100% !important; min-width:unset !important; }
    .gc-media  { width:100%; height:100%; object-fit:cover; display:block; }
    .gc-media-video { width:100%; height:100%; object-fit:cover; display:block; background:#000; }
    .gc-wide   { grid-column:unset !important; flex-direction:column !important; }
    .gc {
      background:var(--navy-2); border:1px solid var(--border); border-radius:22px;
      overflow:hidden; display:flex; flex-direction:column;
      transition:transform .35s var(--ease-spring), box-shadow .35s, border-color .3s;
      cursor:pointer;
    }
    .gc:hover { transform:translateY(-8px); box-shadow:0 24px 56px rgba(0,0,0,0.08); }
    .gc-visual {
      height:180px; position:relative; overflow:hidden;
      display:flex; align-items:center; justify-content:center;
      flex-shrink:0;
    }
    .gc-visual.v-gold   { background:linear-gradient(135deg,rgba(245,200,66,0.25) 0%,rgba(180,83,9,0.18) 100%); }
    .gc-visual.v-uni    { background:linear-gradient(135deg,rgba(124,58,237,0.22),rgba(56,189,248,0.18),rgba(219,39,119,0.16)); }
    .gc-visual.v-blue   { background:linear-gradient(135deg,rgba(56,189,248,0.25),rgba(30,58,138,0.2)); }
    .gc-visual.v-purple { background:linear-gradient(135deg,rgba(192,38,211,0.22),rgba(124,58,237,0.2)); }
    .gc-visual-crown {
      width:90px; height:90px; position:relative;
      filter:drop-shadow(0 12px 28px rgba(0,0,0,0.2));
      transition:transform .35s var(--ease-spring);
    }
    .gc:hover .gc-visual-crown { transform:scale(1.1) translateY(-4px); }
    .gc-badge {
      position:absolute; top:12px; left:12px;
      background:rgba(0,0,0,0.35); backdrop-filter:blur(8px);
      border:1px solid rgba(255,255,255,0.15);
      border-radius:50px; padding:4px 12px;
      font-size:11px; font-weight:700; color:#fff; letter-spacing:0.5px;
    }
    .gc-before {
      position:absolute; top:12px; right:12px;
      background:rgba(180,180,190,0.22); backdrop-filter:blur(8px);
      border:1px solid rgba(255,255,255,0.1);
      border-radius:50px; padding:4px 11px;
      font-size:10px; font-weight:600; color:rgba(255,255,255,0.7); letter-spacing:0.3px;
    }
    .gc-body { padding:24px 22px 26px; flex:1; display:flex; flex-direction:column; }
    .gc-meta { font-size:11.5px; font-weight:600; color:var(--text-dim); letter-spacing:0.5px; margin-bottom:9px; text-transform:uppercase; }
    .gc-headline { font-size:15.5px; font-weight:700; line-height:1.38; margin-bottom:10px; color:var(--white); }
    .gc-detail { font-size:13.5px; color:var(--text-muted); line-height:1.6; flex:1; }
    .gc-footer {
      display:flex; align-items:center; gap:8px;
      margin-top:18px; padding-top:16px; border-top:1px solid var(--border);
    }
    .gc-result-pill {
      display:inline-flex; align-items:center; gap:5px;
      background:rgba(5,150,105,0.09); border:1px solid rgba(5,150,105,0.18);
      border-radius:50px; padding:3px 10px;
      font-size:11px; font-weight:700; color:var(--green);
    }
    .gc-result-pill::before { content:''; width:5px;height:5px;border-radius:50%;background:var(--green); flex-shrink:0; }
    .gc-doc { font-size:12px; color:var(--text-dim); margin-left:auto; }

    /* Wide card (spans 2 cols) */
    .gc-wide { grid-column:span 2; flex-direction:row; }
    .gc-wide .gc-visual { width:260px; min-width:260px; height:auto; flex-shrink:0; }
    .gc-wide .gc-body { justify-content:center; }

    /* ── TESTIMONIALS 3D COVERFLOW ── */
    .testimonials { background:var(--navy-3); border-top:1px solid var(--border); padding:80px 0 100px; }
    .testimonials-inner { max-width:1300px; margin:0 auto; text-align:center; padding:0 40px; }

    /* 3D Stage */
    .tc-stage {
      position:relative; height:540px; margin-top:64px;
      perspective:1100px; perspective-origin:50% 44%;
    }

    /* Card base — all cards start hidden at back */
    .tc-card {
      position:absolute; width:310px; left:50%; top:50%;
      border-radius:22px; overflow:hidden; cursor:pointer;
      transition:transform 0.65s cubic-bezier(0.16,1,0.3,1),
                 opacity   0.65s cubic-bezier(0.16,1,0.3,1),
                 box-shadow 0.4s ease;
      box-shadow:0 20px 60px rgba(0,0,0,0.45);
      transform:translateX(-50%) translateY(-50%) translateZ(-700px) scale(0.2);
      opacity:0; will-change:transform,opacity; user-select:none;
    }
    .tc-card.tc-active { cursor:default; box-shadow:0 32px 80px rgba(0,0,0,0.55); }

    /* Card top — full-width photo portrait */
    .tc-top {
      height:250px; position:relative; overflow:hidden;
    }
    .tc-top img {
      width:100%; height:100%; object-fit:cover; display:block;
    }
    .tc-top::after {
      content:''; position:absolute; inset:0;
      background:linear-gradient(to bottom, rgba(0,0,0,0.05) 30%, rgba(13,27,53,0.75) 100%);
      pointer-events:none;
    }
    /* Colored accent bar at very top of photo */
    .tc-top::before {
      content:''; position:absolute; top:0; left:0; right:0; height:5px;
      background:var(--accent,#8b5cf6); z-index:3;
    }

    /* Card bottom — dark charcoal body */
    .tc-body {
      background:#0d1b35; padding:20px 22px 24px; text-align:center;
    }
    .tc-stars { color:#f5c842; font-size:14px; letter-spacing:4px; margin-bottom:12px; }
    .tc-quote {
      font-size:13px; line-height:1.7; color:rgba(255,255,255,0.82);
      font-style:italic; font-family:'Playfair Display',serif; margin-bottom:16px;
      display:-webkit-box; -webkit-line-clamp:4; -webkit-box-orient:vertical; overflow:hidden;
    }
    .tc-card.tc-active .tc-quote {
      -webkit-line-clamp:unset; overflow:visible; font-size:14px;
      color:rgba(255,255,255,0.95);
    }
    .tc-name  { font-weight:700; font-size:13.5px; color:#fff; line-height:1.3; }
    .tc-role  { font-size:11.5px; color:rgba(255,255,255,0.5); margin-top:3px; }
    .tc-prac  { font-size:11.5px; color:#a78bfa; font-weight:600; margin-top:4px; }
    .tc-hdl   { font-size:10.5px; color:rgba(255,255,255,0.3); margin-top:5px; }

    /* Controls */
    .carousel-controls { display:flex; align-items:center; justify-content:center; gap:16px; margin-top:28px; }
    .carousel-dots { display:flex; gap:7px; align-items:center; }
    .cdot {
      width:8px; height:8px; border-radius:4px; border:none; padding:0; cursor:pointer;
      background:rgba(139,92,246,0.22); transition:all 0.35s var(--ease-spring);
    }
    .cdot.active { width:26px; background:var(--purple); }
    .cnav-btn {
      width:44px; height:44px; border-radius:50%; border:1.5px solid rgba(0,0,60,0.15);
      background:#0d1b35; cursor:pointer; color:rgba(255,255,255,0.6); font-size:18px;
      display:flex; align-items:center; justify-content:center;
      transition:all 0.25s var(--ease-spring);
    }
    .cnav-btn:hover { background:#7c3aed; border-color:#7c3aed; color:#fff; transform:scale(1.08); }
    @media(max-width:900px){
      .tc-stage { height:460px; }
      .tc-card  { width:270px; }
    }
    @media(max-width:600px){
      .tc-stage { height:440px; perspective:700px; }
      .tc-card  { width:250px; }
      .tc-top   { height:130px; }
      .tc-av    { width:72px; height:72px; font-size:22px; }
    }

    /* ── KITS ── */
    .kits-section { background:var(--navy);border-top:1px solid var(--border); }
    .kits-inner { max-width:1080px;margin:0 auto; }
    .kits-grid { display:grid;grid-template-columns:1fr 1fr 1fr;gap:28px;margin-top:52px; }
    .kit-card { border-radius:24px;padding:48px 42px;border:1px solid var(--border);position:relative;overflow:hidden;transition:transform .3s var(--ease-spring);display:flex;flex-direction:column; }
    .kit-card a[href] { margin-top:auto; }
    .kit-card:hover { transform:translateY(-5px); }
    .kit-card.intro  { background:linear-gradient(140deg,rgba(56,189,248,0.1),rgba(56,189,248,0.03));border-color:rgba(56,189,248,0.18); }
    .kit-card.pro    { background:linear-gradient(140deg,rgba(245,200,66,0.1),rgba(245,200,66,0.03));border-color:rgba(245,200,66,0.22); }
    .kit-card.refill { background:linear-gradient(140deg,rgba(52,211,153,0.12),rgba(52,211,153,0.03));border-color:rgba(52,211,153,0.28); }
    .kit-badge { display:inline-block;border-radius:50px;padding:5px 14px;font-size:11.5px;font-weight:700;letter-spacing:1px;text-transform:uppercase;margin-bottom:20px; }
    .intro  .kit-badge { background:rgba(56,189,248,0.12);color:var(--blue); }
    .pro    .kit-badge { background:rgba(245,200,66,0.12);color:var(--gold); }
    .refill .kit-badge { background:rgba(52,211,153,0.15);color:#059669; }
    .kit-card h3 { font-family:'Playfair Display',serif;font-size:30px;font-weight:900;margin-bottom:8px; }
    .kit-num { font-size:52px;font-weight:800;line-height:1;margin-bottom:4px; }
    .intro  .kit-num { color:var(--blue); }
    .pro    .kit-num { color:var(--gold); }
    .refill .kit-num { color:#059669; }
    .kit-num-sub { font-size:14px;color:var(--text-muted);margin-bottom:24px; }
    .kit-features { list-style:none;margin-bottom:32px;flex:1; }
    .kit-features li { font-size:14.5px;color:rgba(10,22,40,0.75);padding:8px 0;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:10px; }
    .kit-features li:last-child { border-bottom:none; }
    .chk { color:var(--green);font-size:15px; }
    .kit-price { font-size:14px;color:var(--text-muted);margin-bottom:22px; }
    .kit-price strong { font-size:28px;color:var(--white);font-family:'Playfair Display',serif; }
    .popular-tag { position:absolute;top:20px;right:20px;background:linear-gradient(135deg,var(--gold),#e8a500);color:#fff;font-size:10.5px;font-weight:800;padding:5px 12px;border-radius:50px;letter-spacing:0.5px; }

    /* ── PARENTS CTA ── */
    .parents-cta { background:var(--navy-3);text-align:center; }
    .parents-cta-inner {
      max-width:760px;margin:0 auto;
      background:linear-gradient(140deg,rgba(124,58,237,0.07),rgba(2,132,199,0.05));
      border:1px solid rgba(124,58,237,0.18);border-radius:28px;padding:72px 56px;
    }
    .parents-cta h2 { font-family:'Playfair Display',serif;font-size:clamp(26px,3.8vw,44px);font-weight:900;margin-bottom:16px; }
    .parents-cta p  { font-size:17px;color:var(--text-muted);margin-bottom:38px;line-height:1.65; }

    /* ── BLOG ── */
    .blog-section { background:var(--navy);border-top:1px solid var(--border); }
    .blog-inner { max-width:1200px;margin:0 auto; }
    .blog-header { display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:44px; }
    .blog-grid { display:grid;grid-template-columns:repeat(3,1fr);gap:22px; }
    .blog-card { background:var(--navy-2);border:1px solid var(--border);border-radius:20px;overflow:hidden;transition:transform .3s var(--ease-spring),border-color .3s;cursor:pointer;box-shadow:0 2px 12px rgba(0,0,0,0.06); }
    .blog-card:hover { transform:translateY(-6px);border-color:rgba(0,0,60,0.18); }
    .blog-img { height:200px;overflow:hidden;background:var(--navy-2); }
    .blog-img img { width:100%;height:100%;object-fit:contain;display:block;transition:transform .4s ease; }
    .blog-card:hover .blog-img img { transform:scale(1.04); }
    .blog-content { padding:26px; }
    .blog-tag { font-size:10.5px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:var(--gold);margin-bottom:9px; }
    .blog-title { font-size:16px;font-weight:700;line-height:1.4;margin-bottom:10px; }
    .blog-date { font-size:12.5px;color:var(--text-muted); }

    /* ── FOOTER ── */
    footer { background:var(--navy-3);border-top:1px solid var(--border);padding:60px 56px 40px; }
    .footer-inner { max-width:1200px;margin:0 auto; }
    .footer-top { display:grid;grid-template-columns:2fr 1fr 1fr 1fr 1fr;gap:40px;margin-bottom:44px; }
    .footer-logo { display:flex;align-items:center;gap:9px;font-family:'Playfair Display',serif;font-size:22px;font-weight:900;background:linear-gradient(135deg,var(--gold),var(--pink),var(--purple));-webkit-background-clip:text;-webkit-text-fill-color:transparent;margin-bottom:12px; }
    .footer-logo svg { flex-shrink:0; }
    .footer-tagline { font-size:14px;color:var(--text-muted);line-height:1.6;max-width:310px;margin-bottom:22px; }
    .footer-socials { display:flex;gap:10px; }
    .s-icon { width:36px;height:36px;border-radius:10px;background:rgba(0,0,0,0.04);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;cursor:pointer;transition:all .2s;text-decoration:none; }
    .s-icon:hover { background:rgba(0,0,0,0.09); }
    .s-icon svg { width:18px;height:18px;opacity:1; }
    .footer-col h4 { font-size:12px;font-weight:700;letter-spacing:1.2px;text-transform:uppercase;color:var(--text-dim);margin-bottom:18px; }
    .footer-col ul { list-style:none; }
    .footer-col li { margin-bottom:11px; }
    .footer-col a { color:rgba(10,22,40,0.5);text-decoration:none;font-size:14px;transition:color .2s; }
    .footer-col a:hover { color:var(--white); }
    .footer-bottom { border-top:1px solid var(--border);padding-top:26px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px; }
    .footer-copy { font-size:13px;color:var(--text-dim); }
    .footer-made { font-size:13px;color:var(--text-dim);display:flex;align-items:center;gap:6px; }
    .pay-icons { display:flex;gap:7px; }
    .pay-icon { background:rgba(0,0,0,0.04);border:1px solid var(--border);border-radius:6px;padding:4px 10px;font-size:11px;font-weight:600;color:var(--text-dim); }

    /* ══════════════════════════
     FOR PARENTS PAGE
  ══════════════════════════ */
  #page-parents, #page-compare { display:none; }

  /* Parents Hero */
  .parents-hero {
    min-height:88vh; display:flex; align-items:center;
    padding-top:120px; padding-bottom:80px;
    position:relative; overflow:hidden;
    background:linear-gradient(160deg,#fdfbff 0%,#f0eeff 55%,#e8f4ff 100%);
  }
  .parents-hero-bg {
    position:absolute; inset:0; pointer-events:none;
    background:
      radial-gradient(ellipse 70% 60% at 80% 30%,rgba(124,58,237,0.09) 0%,transparent 60%),
      radial-gradient(ellipse 50% 50% at 20% 70%,rgba(219,39,119,0.06) 0%,transparent 55%);
  }
  .parents-hero-inner {
    width:100%; max-width:1160px; margin:0 auto; padding:0 56px;
    display:grid; grid-template-columns:1fr 1fr; gap:72px; align-items:center;
    position:relative; z-index:2;
  }
  .parents-hero-badge {
    display:inline-flex; align-items:center; gap:8px;
    background:rgba(219,39,119,0.08); border:1px solid rgba(219,39,119,0.25);
    border-radius:50px; padding:7px 16px;
    font-size:11.5px; font-weight:700; color:var(--pink); margin-bottom:24px; letter-spacing:1px;
    text-transform:uppercase;
  }
  .parents-hero h1 {
    font-family:'Playfair Display',serif;
    font-size:clamp(26px,3vw,42px); font-weight:900; line-height:1.15; margin-bottom:20px;
  }
  .parents-hero h1 .ph-plain { display:block; color:var(--white); }
  .parents-hero h1 .ph-grad {
    display:block;
    background:linear-gradient(120deg,var(--pink) 0%,var(--purple) 55%,var(--blue) 100%);
    -webkit-background-clip:text; -webkit-text-fill-color:transparent;
  }
  .parents-hero-sub { font-size:17px; color:var(--text-muted); line-height:1.7; max-width:440px; margin-bottom:36px; }
  .parents-hero-btns { display:flex; gap:12px; flex-wrap:wrap; }

  .parents-hero-visual {
    display:flex; align-items:center; justify-content:center; position:relative;
  }
  .parents-crown-img {
    width:100%; max-width:460px; display:block;
    animation:img-float 5s ease-in-out infinite;
    filter:drop-shadow(0 24px 48px rgba(124,58,237,0.18));
  }

  /* Stat floating card on hero */
  .parents-stat-float {
    position:absolute; bottom:-10px; left:-20px;
    background:#fff; border-radius:18px; padding:18px 24px;
    box-shadow:0 12px 40px rgba(0,0,0,0.12); border:1px solid var(--border);
    text-align:center; min-width:130px;
    animation:img-float 6s ease-in-out infinite reverse;
  }
  .parents-stat-float .psf-num {
    font-family:'Playfair Display',serif; font-size:36px; font-weight:900;
    background:linear-gradient(135deg,var(--gold),var(--pink));
    -webkit-background-clip:text; -webkit-text-fill-color:transparent;
    line-height:1;
  }
  .parents-stat-float .psf-label { font-size:11px; color:var(--text-muted); font-weight:600; margin-top:4px; line-height:1.4; }

  /* Parents feature sections alternating */
  .p-section { padding:88px 56px; }
  .p-section-inner { max-width:1140px; margin:0 auto; }

  /* Insurance/pricing section (dark) */
  .p-price { background:var(--white); color:#fff; }
  .p-price .section-label { color:rgba(245,200,66,0.8); }
  .p-price .section-title { color:#fff; }
  .p-price .section-sub { color:rgba(255,255,255,0.65); }
  .p-price-grid { display:grid; grid-template-columns:1fr 1fr 1fr; gap:24px; margin-top:52px; }
  .p-price-card {
    border-radius:20px; padding:36px 32px;
    border:1px solid rgba(255,255,255,0.12);
    background:rgba(255,255,255,0.06);
    backdrop-filter:blur(8px);
  }
  .p-price-card.accent { background:rgba(245,200,66,0.1); border-color:rgba(245,200,66,0.28); }
  .p-price-card.warn { background:rgba(220,53,69,0.08); border-color:rgba(220,53,69,0.25); }

{
  "sections": {
    "comparison_prismo": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "{% capture prismo_src %}<style>\n.prismo-cmp{font-family:'Outfit',sans-serif;background:#fff}\n/* ── Hero ── */\n.prismo-cmp-hero{background:linear-gradient(135deg,#0d0a2e 0%,#0a1628 45%,#1a0d3e 100%);padding:64px 24px 52px;text-align:center;position:relative;overflow:hidden}\n.prismo-cmp-grid{position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.03) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.03) 1px,transparent 1px);background-size:40px 40px;mask-image:radial-gradient(ellipse 90% 90% at 50% 50%,black 30%,transparent 80%);pointer-events:none}\n.prismo-cmp-orb{position:absolute;border-radius:50%;filter:blur(60px);pointer-events:none;animation:pcmp-float 9s ease-in-out infinite}\n.pcmp-o1{width:260px;height:260px;background:rgba(124,58,237,.2);top:-60px;right:8%}\n.pcmp-o2{width:180px;height:180px;background:rgba(212,144,10,.15);bottom:-30px;left:12%;animation-delay:-5s}\n.pcmp-o3{width:140px;height:140px;background:rgba(219,39,119,.15);top:30%;left:35%;animation-delay:-3s}\n@keyframes pcmp-float{0%,100%{transform:translateY(0)}50%{transform:translateY(-16px)}}\n.prismo-cmp-hi{position:relative;z-index:2;max-width:700px;margin:0 auto;transition:transform .15s ease}\n.prismo-cmp-tag{display:inline-flex;align-items:center;gap:6px;background:rgba(212,144,10,.12);border:1px solid rgba(212,144,10,.35);color:#d4900a;font-size:11px;font-weight:700;letter-spacing:2px;text-transform:uppercase;padding:5px 14px;border-radius:100px;margin-bottom:16px}\n.prismo-cmp-dot{width:5px;height:5px;border-radius:50%;background:#d4900a;display:inline-block}\n.prismo-cmp-title{font-size:clamp(2rem,5vw,3.2rem);font-weight:800;background:linear-gradient(135deg,#d4900a 0%,#db2777 50%,#7c3aed 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;margin:0 0 14px;line-height:1.15}\n.prismo-cmp-sub{color:rgba(255,255,255,.62);font-size:1.05rem;margin:0 auto;line-height:1.6;max-width:520px}\n/* ── Table section ── */\n.prismo-cmp-body{padding:56px 24px 64px;background:#f5f7fc}\n.prismo-cmp-wrap{max-width:900px;margin:0 auto}\n.prismo-cmp-label{text-align:center;font-size:12px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:#7c3aed;margin-bottom:12px}\n.prismo-cmp-intro{text-align:center;font-size:1.05rem;color:#4a5568;margin:0 auto 40px;max-width:580px;line-height:1.6}\n/* 3D tilt container */\n.prismo-cmp-3d{perspective:1200px;cursor:default}\n.prismo-cmp-card{background:#fff;border-radius:20px;overflow:hidden;box-shadow:0 4px 24px rgba(0,0,0,.08);transition:transform .12s ease,box-shadow .12s ease;transform-style:preserve-3d}\n/* Table */\n.prismo-tbl{width:100%;border-collapse:collapse;font-size:15px}\n.prismo-tbl thead tr{background:linear-gradient(135deg,#0a1628,#1a0d3e)}\n.prismo-tbl th{padding:18px 20px;font-weight:700;font-size:13px;letter-spacing:.5px}\n.prismo-tbl th:first-child{text-align:left;color:rgba(255,255,255,.5);width:32%}\n.prismo-tbl th.col-silver{text-align:center;color:rgba(255,255,255,.55);border-left:1px solid rgba(255,255,255,.07)}\n.prismo-tbl th.col-zr{text-align:center;color:rgba(255,255,255,.55);border-left:1px solid rgba(255,255,255,.07)}\n.prismo-tbl th.col-prismo{text-align:center;background:linear-gradient(135deg,rgba(212,144,10,.25),rgba(124,58,237,.18));color:#f0b429;border-left:2px solid rgba(212,144,10,.4);border-right:2px solid rgba(212,144,10,.4);position:relative}\n.prismo-tbl th.col-prismo::after{content:'BEST CHOICE';position:absolute;top:-1px;left:50%;transform:translateX(-50%);background:linear-gradient(135deg,#d4900a,#db2777);color:#fff;font-size:9px;font-weight:800;letter-spacing:1.5px;padding:3px 10px;border-radius:0 0 8px 8px}\n.prismo-tbl tbody tr{border-bottom:1px solid #e8edf4;transition:background .2s}\n.prismo-tbl tbody tr:hover{background:#f0f4ff}\n.prismo-tbl tbody tr:last-child{border-bottom:none}\n.prismo-tbl td{padding:16px 20px;vertical-align:middle}\n.prismo-tbl td:first-child{color:#1a202c;font-weight:600;font-size:14px}\n.prismo-tbl td.col-silver{text-align:center;color:#718096;border-left:1px solid #e8edf4}\n.prismo-tbl td.col-zr{text-align:center;color:#718096;border-left:1px solid #e8edf4}\n.prismo-tbl td.col-prismo{text-align:center;background:rgba(212,144,10,.04);border-left:2px solid rgba(212,144,10,.2);border-right:2px solid rgba(212,144,10,.2)}\n.prismo-tbl td small{display:block;font-size:11px;color:#a0aec0;font-weight:400;margin-top:2px}\n/* icons */\n.cmp-yes{color:#059669;font-size:18px;font-weight:800}\n.cmp-no{color:#e53e3e;font-size:18px;font-weight:800}\n.cmp-maybe{color:#d4900a;font-size:14px;font-weight:700}\n/* Prismo brand badge in col */\n.prismo-badge{display:inline-flex;align-items:center;gap:5px;background:linear-gradient(135deg,rgba(212,144,10,.12),rgba(124,58,237,.08));border:1px solid rgba(212,144,10,.3);border-radius:8px;padding:4px 10px;font-size:12px;font-weight:700;color:#d4900a}\n/* Colors swatch */\n.cmp-swatches{display:inline-flex;gap:4px;justify-content:center}\n.cmp-swatch{width:14px;height:14px;border-radius:50%;display:inline-block;border:1.5px solid rgba(255,255,255,.8);box-shadow:0 1px 3px rgba(0,0,0,.2)}\n/* CTA */\n.prismo-cmp-cta{text-align:center;padding:48px 24px 56px;background:#fff}\n.prismo-cmp-cta h3{font-size:1.6rem;font-weight:800;color:#0a1628;margin:0 0 12px;background:linear-gradient(135deg,#d4900a,#db2777,#7c3aed);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}\n.prismo-cmp-cta p{color:#4a5568;margin:0 0 28px;font-size:1rem;line-height:1.6}\n.prismo-cmp-btn{display:inline-block;background:linear-gradient(135deg,#d4900a,#db2777,#7c3aed);color:#fff;font-family:'Outfit',sans-serif;font-size:15px;font-weight:700;padding:14px 36px;border-radius:100px;text-decoration:none;transition:transform .2s ease,box-shadow .2s ease;box-shadow:0 4px 20px rgba(212,144,10,.35)}\n.prismo-cmp-btn:hover{transform:translateY(-2px) scale(1.02);box-shadow:0 8px 32px rgba(212,144,10,.5)}\n@media(max-width:640px){.prismo-tbl{font-size:13px}.prismo-tbl th,.prismo-tbl td{padding:12px 10px}.prismo-tbl th:first-child,.prismo-tbl td:first-child{width:28%}}\n</style>\n<div class=\"prismo-cmp\">\n  <!-- Hero -->\n  <div class=\"prismo-cmp-hero\" id=\"prismoCmpHero\">\n    <div class=\"prismo-cmp-grid\"></div>\n    <div class=\"prismo-cmp-orb pcmp-o1\"></div>\n    <div class=\"prismo-cmp-orb pcmp-o2\"></div>\n    <div class=\"prismo-cmp-orb pcmp-o3\"></div>\n    <div class=\"prismo-cmp-hi\" id=\"prismoCmpHi\">\n      <div class=\"prismo-cmp-tag\"><span class=\"prismo-cmp-dot\"></span>Prismo Crowns</div>\n      <h1 class=\"prismo-cmp-title\">How We Compare</h1>\n      <p class=\"prismo-cmp-sub\">Same preparation. Same cement. A completely different experience for children — and for your practice.</p>\n    </div>\n  </div>\n  <!-- Table -->\n  <div class=\"prismo-cmp-body\">\n    <div class=\"prismo-cmp-wrap\">\n      <p class=\"prismo-cmp-label\">Side-by-Side Comparison</p>\n      <p class=\"prismo-cmp-intro\">Prismo Crowns are stainless steel crowns — with one major difference. Here's how we stack up against the alternatives.</p>\n      <div class=\"prismo-cmp-3d\" id=\"prismoCmp3D\">\n        <div class=\"prismo-cmp-card\" id=\"prismoCmpCard\">\n          <table class=\"prismo-tbl\">\n            <thead>\n              <tr>\n                <th></th>\n                <th class=\"col-silver\">Traditional SSC<br><small style=\"color:rgba(255,255,255,.4);font-weight:400\">Silver Stainless Steel</small></th>\n                <th class=\"col-prismo\">Prismo Crowns<br><small style=\"color:rgba(240,180,41,.7);font-weight:400\">Colored SSC</small></th>\n                <th class=\"col-zr\">Zirconia Crowns<br><small style=\"color:rgba(255,255,255,.4);font-weight:400\">Ceramic</small></th>\n              </tr>\n            </thead>\n            <tbody>\n              <tr>\n                <td>Crown Material</td>\n                <td class=\"col-silver\">Stainless steel<small>Standard grade</small></td>\n                <td class=\"col-prismo\"><span class=\"prismo-badge\">✦ Stainless steel</span><small>Laser-color coated</small></td>\n                <td class=\"col-zr\">Zirconia ceramic<small>Brittle under load</small></td>\n              </tr>\n              <tr>\n                <td>Available Colors</td>\n                <td class=\"col-silver\"><span class=\"cmp-no\">✕</span><small>Silver only</small></td>\n                <td class=\"col-prismo\">\n                  <div class=\"cmp-swatches\">\n                    <span class=\"cmp-swatch\" style=\"background:#e53935\"></span>\n                    <span class=\"cmp-swatch\" style=\"background:#f4a100\"></span>\n                    <span class=\"cmp-swatch\" style=\"background:#fdd835\"></span>\n                    <span class=\"cmp-swatch\" style=\"background:#43a047\"></span>\n                    <span class=\"cmp-swatch\" style=\"background:#1e88e5\"></span>\n                    <span class=\"cmp-swatch\" style=\"background:#8e24aa\"></span>\n                    <span class=\"cmp-swatch\" style=\"background:#f06292\"></span>\n                    <span class=\"cmp-swatch\" style=\"background:#26c6da\"></span>\n                  </div>\n                  <small>8 vibrant colors</small>\n                </td>\n                <td class=\"col-zr\"><span class=\"cmp-maybe\">◑</span><small>White only</small></td>\n              </tr>\n              <tr>\n                <td>Child Acceptance</td>\n                <td class=\"col-silver\"><span class=\"cmp-no\">✕</span><small>Often resisted</small></td>\n                <td class=\"col-prismo\"><span class=\"cmp-yes\">✓</span><small>Kids ask for them</small></td>\n                <td class=\"col-zr\"><span class=\"cmp-maybe\">◑</span><small>Neutral</small></td>\n              </tr>\n              <tr>\n                <td>Standard Crown Prep</td>\n                <td class=\"col-silver\"><span class=\"cmp-yes\">✓</span></td>\n                <td class=\"col-prismo\"><span class=\"cmp-yes\">✓</span><small>No changes needed</small></td>\n                <td class=\"col-zr\"><span class=\"cmp-no\">✕</span><small>More tooth reduction</small></td>\n              </tr>\n              <tr>\n                <td>Standard Cementation</td>\n                <td class=\"col-silver\"><span class=\"cmp-yes\">✓</span></td>\n                <td class=\"col-prismo\"><span class=\"cmp-yes\">✓</span><small>Any glass ionomer cement</small></td>\n                <td class=\"col-zr\"><span class=\"cmp-maybe\">◑</span><small>Specific cement required</small></td>\n              </tr>\n              <tr>\n                <td>Behavior Management Benefit</td>\n                <td class=\"col-silver\"><span class=\"cmp-no\">✕</span></td>\n                <td class=\"col-prismo\"><span class=\"cmp-yes\">✓</span><small>Documented improvement</small></td>\n                <td class=\"col-zr\"><span class=\"cmp-no\">✕</span></td>\n              </tr>\n              <tr>\n                <td>Durability</td>\n                <td class=\"col-silver\"><span class=\"cmp-yes\">✓</span><small>Very durable</small></td>\n                <td class=\"col-prismo\"><span class=\"cmp-yes\">✓</span><small>Full stainless steel core</small></td>\n                <td class=\"col-zr\"><span class=\"cmp-maybe\">◑</span><small>Fracture risk under load</small></td>\n              </tr>\n              <tr>\n                <td>Patented Technology</td>\n                <td class=\"col-silver\"><span class=\"cmp-no\">✕</span></td>\n                <td class=\"col-prismo\"><span class=\"cmp-yes\">✓</span><small>Laser-assisted coloring</small></td>\n                <td class=\"col-zr\"><span class=\"cmp-no\">✕</span></td>\n              </tr>\n              <tr>\n                <td>Made in USA</td>\n                <td class=\"col-silver\"><span class=\"cmp-maybe\">◑</span><small>Varies by brand</small></td>\n                <td class=\"col-prismo\"><span class=\"cmp-yes\">✓</span></td>\n                <td class=\"col-zr\"><span class=\"cmp-maybe\">◑</span><small>Varies by brand</small></td>\n              </tr>\n              <tr>\n                <td>Price per Crown</td>\n                <td class=\"col-silver\"><small>$$ – $$$</small></td>\n                <td class=\"col-prismo\"><small style=\"color:#059669;font-weight:700\">Comparable to major SSC brands</small></td>\n                <td class=\"col-zr\"><small>$$$$</small></td>\n              </tr>\n            </tbody>\n          </table>\n        </div>\n      </div>\n    </div>\n  </div>\n  <!-- CTA -->\n  <div class=\"prismo-cmp-cta\">\n    <h3>Ready to Try Prismo Crowns?</h3>\n    <p>Our Intro Kit includes 48 crowns in sizes 3, 4 &amp; 5 — everything you need to start offering a better experience.</p>\n    <a href=\"/collections/all\" class=\"prismo-cmp-btn\">Shop the Intro Kit</a>\n  </div>\n</div>\n<script>\n(function(){\n  var hero=document.getElementById('prismoCmpHero'),hi=document.getElementById('prismoCmpHi');\n  var wrap=document.getElementById('prismoCmp3D'),card=document.getElementById('prismoCmpCard');\n  if(hero&&hi){\n    hero.addEventListener('mousemove',function(e){\n      var r=hero.getBoundingClientRect(),x=(e.clientX-r.left)/r.width-.5,y=(e.clientY-r.top)/r.height-.5;\n      hi.style.transform='perspective(900px) rotateY('+(x*9)+'deg) rotateX('+(-y*6)+'deg)';\n    });\n    hero.addEventListener('mouseleave',function(){hi.style.transform='perspective(900px) rotateY(0deg) rotateX(0deg)';});\n  }\n  if(wrap&&card){\n    wrap.addEventListener('mousemove',function(e){\n      var r=wrap.getBoundingClientRect(),x=(e.clientX-r.left)/r.width-.5,y=(e.clientY-r.top)/r.height-.5;\n      card.style.transform='perspective(1200px) rotateY('+(x*5)+'deg) rotateX('+(-y*3)+'deg)';\n      card.style.boxShadow='0 '+(8+y*20)+'px '+(24+Math.abs(y)*30)+'px rgba(0,0,0,'+(0.08+Math.abs(y)*0.06)+'), '+(x*10)+'px 0 20px rgba(124,58,237,0.05)';\n    });\n    wrap.addEventListener('mouseleave',function(){\n      card.style.transform='perspective(1200px) rotateY(0deg) rotateX(0deg)';\n      card.style.boxShadow='0 4px 24px rgba(0,0,0,.08)';\n    });\n  }\n})();\n</script>{% endcapture %}{% render 'prismo-es', html: prismo_src %}",

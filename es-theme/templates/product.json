se if (colorIndex === 2) opt = v.option3;\n\nif (opt && opt.toLowerCase() === target) {\nreturn v;\n}\n}\nreturn null;\n}\n\nfunction detectCurrentPageColor() {\nvar title = (refillProduct && refillProduct.title ? refillProduct.title : '').toLowerCase();\nvar path = window.location.pathname.toLowerCase();\n\nif (title.indexOf('blue') !== -1 || path.indexOf('blue') !== -1) return 'Blue';\nif (title.indexOf('gold') !== -1 || path.indexOf('gold') !== -1) return 'Gold';\nif (title.indexOf('unicorn') !== -1 || path.indexOf('unicorn') !== -1) return 'Unicorn';\nif (title.indexOf('assorted') !== -1 || path.indexOf('assorted') !== -1) return 'Assorted';\n\nreturn null;\n}\n\nfunction getMainProductForm() {\nreturn document.querySelector('product-form form[action=\"/cart/add\"]') ||\ndocument.querySelector('form[action=\"/cart/add\"]');\n}\n\nfunction triggerNativeAddToCart(targetVariantId) {\nvar form = getMainProductForm();\nif (!form) {\nalert('Main product form not found.');\nreturn;\n}\n\nvar idInput = form.querySelector('input[name=\"id\"]');\nif (!idInput) {\nalert('Variant input not found.');\nreturn;\n}\n\nvar submitButton =\nform.querySelector('button[type=\"submit\"]') ||\nform.querySelector('[name=\"add\"]');\n\nif (!submitButton) {\nalert('Add to cart button not found.');\nreturn;\n}\n\nvar originalVariantId = idInput.value;\n\nidInput.value = String(targetVariantId);\n\nsubmitButton.click();\n\nsetTimeout(function() {\nidInput.value = originalVariantId;\n}, 700);\n}\n\nvar introBtn = document.getElementById('intro-kit-button');\nvar proBtn = document.getElementById('pro-kit-button');\n\nif (introBtn) {\nintroBtn.addEventListener('click', function(e) {\ne.preventDefault();\n\nwindow.location.href = '/products/prismo-intro-kit';\n});\n}\n\nif (proBtn) {\nproBtn.addEventListener('click', function(e) {\ne.preventDefault();\n\nwindow.location.href = '/products/prismo-pro-kit-240-crowns';\n});\n}\n});\n</script>{% endcapture %}{% render 'prismo-es', html: prismo_src 
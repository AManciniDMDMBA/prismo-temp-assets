          }
          var wrap = document.createElement('div');
          wrap.className = 'hero-product-img';
          wrap.style.cssText = 'position:relative;';
          var caption = document.createElement('div');
          caption.style.cssText = 'position:absolute;top:4%;left:0;right:0;text-align:center;z-index:2;font-family:\'Outfit\',sans-serif;pointer-events:none;';

    <script>
      (function () {
        var VIDEOS = [
          {
            match: 'Murat',
            name: 'Murat Büyüksefil — Pediatric Dentist',
            src: 'https://cdn.shopify.com/videos/c/vp/eb1c3617fd3448d2a7948e08eb0a81ad/eb1c3617fd3448d2a7948e08eb0a81ad.HD-720p-1.6Mbps-46265640.mp4',
            poster: 'https://cdn.shopify.com/s/files/1/0887/0409/0388/files/preview_images/eb1c3617fd3448d2a7948e08eb0a81ad.thumbnail.0000000000.jpg?v=1745159825'
          },
          {
            match: 'Kaczmarski',
            name: 'Dr. Jon Kaczmarski — Purple Tooth Pediatric Dentistry',
            src: 'https://cdn.shopify.com/videos/c/vp/5963894963624544b8dda513c072b517/5963894963624544b8dda513c072b517.HD-720p-1.6Mbps-46265899.mp4',
            poster: 'https://cdn.shopify.com/s/files/1/0887/0409/0388/files/preview_images/5963894963624544b8dda513c072b517.thumbnail.0000000000.jpg?v=1745160312'
          },
          {
            match: 'Maria Carmen',
            name: 'Dr. Maria Carmen Sanchez — Pediatric Dentist',
            src: 'https://cdn.shopify.com/videos/c/vp/243a554dab5a4b43b4e9f34816c8d4f1/243a554dab5a4b43b4e9f34816c8d4f1.HD-720p-1.6Mbps-46252087.mp4',
            poster: 'https://cdn.shopify.com/s/files/1/0887/0409/0388/files/preview_images/243a554dab5a4b43b4e9f34816c8d4f1.thumbnail.0000000000.jpg?v=1745115979'
          }
        ];

        var overlay, player, nameEl;

        function buildOverlay() {
          overlay = document.createElement('div');
          overlay.className = 'tc-video-overlay';
          overlay.innerHTML =
            '<div class="tc-video-box">' +
            '<button class="tc-video-close" aria-label="Close video">&#10005;</button>' +
            '<video controls playsinline preload="none"></video>' +
            '<div class="tc-video-name"></div>' +
            '</div>';
          document.body.appendChild(overlay);
          player = overlay.querySelector('video');
          nameEl = overlay.querySelector('.tc-video-name');
          function close() {
            player.pause();
            overlay.classList.remove('active');
            document.body.style.overflow = '';
          }
          overlay.querySelector('.tc-video-close').addEventListener('click', close);
          overlay.addEventListener('click', function (e) { if (e.target === overlay) close(); });
          document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && overlay.classList.contains('active')) close();
          });
        }

        function openVideo(v) {
          if (!overlay) buildOverlay();
          if (player.getAttribute('src') !== v.src) {
            player.setAttribute('src', v.src);
            player.setAttribute('poster', v.poster);
          }
          nameEl.textContent = v.name;
          overlay.classList.add('active');
          document.body.style.overflow = 'hidden';
          player.play().catch(function () {});
        }

        function addButtons() {
          var cards = document.querySelectorAll('.tc-card');
          if (!cards.length) return false;
          VIDEOS.forEach(function (v) {
            for (var i = 0; i < cards.length; i++) {
              var nm = cards[i].querySelector('.tc-name');
              var top = cards[i].querySelector('.tc-top');
              if (!nm || !top || nm.textContent.indexOf(v.match) === -1) continue;
              if (top.querySelector('.tc-play')) break;
              if (getComputedStyle(top).position === 'static') top.style.position = 'relative';
              var btn = document.createElement('button');
              btn.className = 'tc-play';
              btn.setAttribute('aria-label', 'Watch video testimonial from ' + v.match);
              btn.innerHTML = '<svg viewBox="0 0 12 12" xmlns="http://www.w3.org/2000/svg"><polygon points="2,1 11,6 2,11" fill="currentColor"/></svg> Watch Video';
              btn.addEventListener('click', function (e) {
                e.preventDefault();
                e.stopPropagation();
                openVideo(v);
              });
              top.appendChild(btn);
              break;
            }
          });
          return true;
        }

        var tries = 0;
        function init() {
          tries++;
          if (!addButtons() && tries < 20) setTimeout(init, 250);
        }
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', init);
        } else {
          init();
        }
      })();
    </script>
    <style>.prismo-rainbow{background:linear-gradient(90deg,#e53935,#f4a100,#d4b800,#43a047,#1e88e5,#8e24aa);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;}</style>
    <script>
      (function () {
        var tries = 0;
        function fixCompareHeading() {
          tries++;
          var scope = document.getElementById('page-compare');
          if (!scope) { if (tries < 20) setTimeout(fixCompareHeading, 250); return; }
          var target = null;
          scope.querySelectorAll('h2').forEach(function (h) {
            if (h.textContent.indexOf('Different Categor') !== -1 || h.textContent.indexOf('Different Color') !== -1) target = h;
          });
          if (!target || target.getAttribute('data-prismo-fixed')) return;
          target.setAttribute('data-prismo-fixed', '1');
          target.innerHTML = 'Not Just a Different <span class="prismo-rainbow">Color</span>.<br>A Different <span class="prismo-rainbow">Experience</span>.';
        }
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', fixCompareHeading);
        } else {
          fixCompareHeading();
        }
      })();
    </script>
    <script>
      (function () {
        function optimizeImages() {
          document.querySelectorAll('img[src*="cdn.shopify.com/s/files"]').forEach(function (img) {
            try {
              var u = new URL(img.src);
              if (!u.searchParams.has('width')) {
                u.searchParams.set('width', '1400');
                img.src = u.toString();
              }
            } catch (e) {}
          });
        }
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', optimizeImages);
        } else {
          optimizeImages();
        }
      })();
    </script>
  {% endcapture %}{% render 'prismo-es', html: prismo_src %}</body>
</html>

            '<span style="display:block;font-size:clamp(17px,1.9vw,25px);font-weight:700;color:#9aa7b5;letter-spacing:1.5px;">From ordinary</span>' +
            '<span style="display:block;font-size:clamp(23px,2.6vw,34px);font-weight:800;letter-spacing:0.5px;background:linear-gradient(90deg,#e53935,#f4a100,#d4b800,#43a047,#1e88e5,#8e24aa);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;">To extraordinary</span>';
          var v = document.createElement('video');
          v.src = SPIN_VIDEO;
          v.autoplay = true;
          v.muted = true;
          v.loop = true;
          v.playsInline = true;
          v.preload = 'auto';
          v.setAttribute('muted', '');
          v.setAttribute('playsinline', '');
          v.setAttribute('aria-label', 'Prismo Crown transforming from silver to unicorn colors');
          v.style.cssText = 'width:100%;display:block;-webkit-mask-image:radial-gradient(closest-side, #000 55%, transparent 86%);mask-image:radial-gradient(closest-side, #000 55%, transparent 86%);';
          wrap.appendChild(caption);
          wrap.appendChild(v);
          heroImg.replaceWith(wrap);
          v.play().catch(function () {});
          var im = document.createElement('img');
          im.src = CROWNS_PHOTO;
          im.alt = 'Prismo Crowns — Unicorn, Gold, Sapphire Blue, and Royal Purple';
          im.style.cssText = 'height:100%;width:auto;display:block;';
          bannerVid.replaceWith(im);
        }
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', swapHero);
        } else {
          swapHero();
        }
      })();
    </script>
    <script>
      (function () {
        var hash = window.location.hash.replace('#', '');
        if (!hash) return;
        var tries = 0;
        function go() {
          tries++;
          if ((hash === 'parents' || hash === 'compare') && window.showPage) {
            window.showPage(hash);
            return;
          }
          if (hash === 'faq' || hash === 'contact') {
            var el = document.querySelector('[data-' + hash + ']');
            if (el) {
              el.click();
              return;
            }
          }
          if (tries < 20) setTimeout(go, 150);
        }
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', function () { setTimeout(go, 100); });
        } else {
          setTimeout(go, 100);
        }
      })();
    </script>
    <style>

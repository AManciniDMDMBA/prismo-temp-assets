    {{ content_for_layout }}{% capture prismo_src %}
    <script>
      (function () {
        var tries = 0;
        function addFaqLink() {
          tries++;
          var navLinks = document.querySelector('nav .nav-links');
          if (!navLinks) {
            if (tries < 20) setTimeout(addFaqLink, 250);
            return;
          }
          if (navLinks.querySelector('.nav-faq-link')) return;
          var li = document.createElement('li');
          var a = document.createElement('a');
          a.href = '#';
          a.textContent = 'FAQ';
          a.className = 'nav-faq-link';
          a.addEventListener('click', function (e) {
            e.preventDefault();
            var trigger = document.querySelector('[data-faq]');
            if (trigger) trigger.click();
          });
          li.appendChild(a);
          var contactLi = navLinks.querySelector('[data-contact]');
          if (contactLi && contactLi.closest('li')) {
            navLinks.insertBefore(li, contactLi.closest('li'));
          } else {
            navLinks.appendChild(li);
          }
        }
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', addFaqLink);
        } else {
          addFaqLink();
        }
      })();
    </script>
    <script>
      (function () {
        var tries = 0;
        function addSamplesFaq() {
          tries++;
          var modal = document.getElementById('faqModal');
          if (!modal) {
            if (tries < 20) setTimeout(addSamplesFaq, 250);
            return;
          }
          if (modal.querySelector('.faq-samples-item')) return;
          var anchor = null;
          modal.querySelectorAll('.faq-item .faq-q').forEach(function (btn) {
            if (btn.textContent.indexOf('Pricing') !== -1) anchor = btn.closest('.faq-item');
          });
          var item = document.createElement('div');
          item.className = 'faq-item faq-samples-item';
          item.innerHTML =
            '<button class="faq-q">Do you offer free samples?<span class="faq-q-icon">+</span></button>' +
            '<div class="faq-a"><div class="faq-a-inner">' +
            'We don’t — because there’s nothing to trial. Prismo Crowns are the same proven stainless steel crown system dentists have trusted since 1957: same prep, same cementation, same clinical fit you already know. The only thing that’s new is the color.<br><br>' +
            'The best introduction is the <strong>Intro Kit</strong> — 48 crowns in sizes 3, 4 &amp; 5, enough to see how your patients respond across real cases. Prefer to start even smaller? A single <strong>Refill Pack</strong> (5 crowns) works too, though it covers only one size, so it may not fit every case that walks in.<br><br>' +
            'For the full modern pediatric crown experience, the Intro Kit is the way to start.' +
            '</div></div>';
          if (anchor && anchor.parentNode) {
            anchor.parentNode.insertBefore(item, anchor.nextSibling);
          } else {
            var label = modal.querySelector('.faq-section-label');
            if (label && label.parentNode) label.parentNode.appendChild(item);
            else return;
          }
          item.querySelector('.faq-q').addEventListener('click', function () {
            var wasOpen = item.classList.contains('open');
            modal.querySelectorAll('.faq-item').forEach(function (i) { i.classList.remove('open'); });
            if (!wasOpen) item.classList.add('open');
          });
        }
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', addSamplesFaq);
        } else {
          addSamplesFaq();
        }
      })();
    </script>
    <style>
      .prismo-burger {
        display: none;
        background: none;
        border: none;
        cursor: pointer;
        padding: 8px 6px;
        flex-direction: column;
        justify-content: center;
        gap: 4.5px;
      }
      .prismo-burger span {
        display: block;
        width: 21px;
        height: 2px;
        background: #0a1628;
        border-radius: 2px;
        transition: transform .25s, opacity .25s;
      }
      .prismo-burger.open span:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
      .prismo-burger.open span:nth-child(2) { opacity: 0; }
      .prismo-burger.open span:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }
      .prismo-mobile-menu {
        display: none;
        position: fixed;
        top: 95px;
        left: 0;
        right: 0;
        z-index: 199;
        flex-direction: column;
        background: rgba(255,255,255,0.98);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border-bottom: 1px solid rgba(0,0,60,0.1);
        box-shadow: 0 18px 40px rgba(10,22,40,0.12);
        padding: 8px 22px 14px;
        font-family: 'Outfit', sans-serif;
      }
      .prismo-mobile-menu.open { display: flex; }
      .prismo-mobile-menu a {
        padding: 13px 4px;
        color: rgba(10,22,40,0.78);
        text-decoration: none;
        font-size: 15.5px;
        font-weight: 600;
        border-bottom: 1px solid rgba(0,0,60,0.06);
      }
      .prismo-mobile-menu a:last-child { border-bottom: none; }
      @media (max-width: 960px) {
        .prismo-burger { display: flex; }
      }
    </style>
    <script>
      (function () {
        var tries = 0;
        function addBurger() {
          tries++;
          var nav = document.querySelector('nav');
          if (!nav || !nav.querySelector('.nav-logo')) {
            if (tries < 20) setTimeout(addBurger, 250);
            return;
          }
          if (nav.querySelector('.prismo-burger')) return;
          var btn = document.createElement('button');
          btn.className = 'prismo-burger';
          btn.setAttribute('aria-label', 'Open menu');
          btn.setAttribute('aria-expanded', 'false');
          btn.innerHTML = '<span></span><span></span><span></span>';
          nav.insertBefore(btn, nav.firstChild);
          var menu = document.createElement('div');
          menu.className = 'prismo-mobile-menu';
          document.body.appendChild(menu);
          function setOpen(open) {
            menu.classList.toggle('open', open);
            btn.classList.toggle('open', open);
            btn.setAttribute('aria-expanded', open ? 'true' : 'false');
            if (open) menu.style.top = nav.getBoundingClientRect().bottom + 'px';
          }
          var items = [
            ['Shop', function () { window.location.href = '/collections/shop-now'; }],
            ['For Parents', function () { if (window.showPage) window.showPage('parents'); }],
            ['Compare', function () { if (window.showPage) window.showPage('compare'); }],
            ['Insights', function () { window.location.href = '/blogs/news'; }],
            ['Testimonials', function () {
              if (window.showPage) window.showPage('home');
              var el = document.getElementById('section-testimonials');
              if (el) el.scrollIntoView({ behavior: 'smooth' });
            }],
            ['FAQ', function () { var t = document.querySelector('[data-faq]'); if (t) t.click(); }],
            ['Contact', function () { var t = document.querySelector('[data-contact]'); if (t) t.click(); }]
          ];
          items.forEach(function (it) {
            var a = document.createElement('a');
            a.href = '#';
            a.textContent = it[0];
            a.addEventListener('click', function (e) {
              e.preventDefault();
              setOpen(false);
              it[1]();
            });
            menu.appendChild(a);
          });
          btn.addEventListener('click', function () { setOpen(!menu.classList.contains('open')); });
        }
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', addBurger);
        } else {
          addBurger();
        }
      })();
    </script>
    <script>
      (function () {
        var SPIN_VIDEO = 'https://cdn.shopify.com/videos/c/vp/5f235ffcaa5b481aafd862a499028df8/5f235ffcaa5b481aafd862a499028df8.HD-720p-3.0Mbps-86211195.mp4';
        var CROWNS_PHOTO = 'https://cdn.shopify.com/s/files/1/0887/0409/0388/files/crowns-product.png?v=1788791927&width=1200';

<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
    {%- endif -%}
    <title>
      {%- if template.name == 'index' -%}{% if request.locale.iso_code == 'es' %}Prismo Crowns — Coronas dentales pediátricas de colores que los niños aman{% else %}Prismo Crowns — Colored Pediatric Dental Crowns Kids Love{% endif %}
      {%- else -%}
        {{ page_title }}
        {%- if current_page != 1 %} — Page {{ current_page }}{%- endif -%}
        {%- unless page_title contains shop.name %} — {{ shop.name }}{%- endunless -%}
      {%- endif -%}
    </title>
    {%- if page_description %}<meta name="description" content="{{ page_description | escape }}">{%- endif %}
    {%- liquid
      assign seo_title = page_title | default: shop.name
      if template.name == 'index'
        assign seo_title = 'Prismo Crowns — Colored Pediatric Dental Crowns Kids Love'
        if request.locale.iso_code == 'es'
          assign seo_title = 'Prismo Crowns — Coronas dentales pediátricas de colores que los niños aman'
        endif
      endif
      assign seo_description = page_description | default: shop.description | default: shop.name
    -%}
    <meta property="og:site_name" content="{{ shop.name }}">
    <meta property="og:url" content="{{ canonical_url }}">
    <meta property="og:type" content="website">
    <meta property="og:title" content="{{ seo_title | escape }}">
    <meta property="og:description" content="{{ seo_description | escape }}">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ seo_title | escape }}">
    <meta name="twitter:description" content="{{ seo_description | escape }}">
    {%- if template.name == 'index' %}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Prismo Crowns",
      "url": "{{ shop.url }}",
      "logo": "https://cdn.shopify.com/s/files/1/0887/0409/0388/files/prismocrowns-tooth.png",
      "description": "Premium colored stainless-steel pediatric dental crowns. Patented laser-assisted color process. Kids choose the color; dentists keep the clinical workflow they trust.",
      "email": "prismocrowns@gmail.com"
    }
    </script>
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "Prismo Crowns",
      "url": "{{ shop.url }}"
    }
    </script>
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What are Prismo Crowns?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Prismo Crowns are premium stainless steel pediatric dental crowns with vibrant colors created through a patented laser-assisted process that does not modify the surface of the stainless steel — no dye, no paint, no coating. The crowns are 100% biocompatible, and the color won't chip or fade."
          }
        },
        {
          "@type": "Question",
          "name": "How is the color applied? Is it safe?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Color is created through a patented laser-assisted process that does not modify the surface of the stainless steel — no dye, no paint, no coating. The crowns are 100% biocompatible and meet the same safety standards as traditional silver stainless steel crowns."
          }
        },
        {
          "@type": "Question",
          "name": "Does technique differ from traditional silver stainless steel crowns?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Prismo Crowns use the exact same chairside placement technique as conventional silver stainless steel crowns. No new instruments, no new workflow. Your team can start using them from day one."
          }
        },
        {
          "@type": "Question",
          "name": "Do you ship to my country?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We ship to most countries worldwide. Some regions are excluded due to international trade regulations or shipping limitations. If you're unsure whether we deliver to your location, contact us and we'll confirm."
          }
        },
        {
          "@type": "Question",
          "name": "What colors do you offer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Current color options include Gold, Blue, Purple, Assorted, and Unicorn (iridescent/multicolor). Individual color refill packs start at $8.99 ea."
          }
        },
        {
          "@type": "Question",
          "name": "Are Prismo Crowns made in the USA?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, Prismo Crowns are manufactured in the USA."
          }
        },
        {
          "@type": "Question",
          "name": "How do Prismo Crowns bill? Is there a separate code for colored crowns?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No separate code is needed. Prismo Crowns are billed under the exact same CDT code as traditional silver stainless steel crowns. Same prep, same placement, same documentation. Nothing changes on the administrative or clinical side."
          }
        },
        {
          "@type": "Question",
          "name": "Are these crowns safe for my child?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Absolutely. Prismo Crowns are 100% biocompatible, made from the same surgical-grade stainless steel used in traditional pediatric crowns for decades. The color is created by a patented laser-assisted process that does not modify the surface of the steel — no dye, no paint, no coating."
          }
        },
        {
          "@type": "Question",
          "name": "Will my insurance cover a colored crown?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "If Silver is covered then Prismo is also covered, yes (all major dental insurances including Medicaid). Prismo Crowns are billed under the same dental code as standard stainless steel crowns, so insurance treats them the same. Ask your dentist to confirm coverage with your specific plan."
          }
        },
        {
          "@type": "Question",
          "name": "Will the color chip or fade?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Because the color comes from a patented laser-assisted process that does not modify the surface of the stainless steel — no dye, no paint, no coating — it is as durable as the silver crown. Normal brushing, eating, and drinking won't affect it, and the crowns are 100% biocompatible."
          }
        },
        {
          "@type": "Question",
          "name": "Does my child's dentist need special training?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No special training is needed. Prismo Crowns are placed exactly like traditional silver stainless steel crowns, so any pediatric or general dentist already knows how to use them."
          }
        },
        {
          "@type": "Question",
          "name": "Will my child actually like a colored crown?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most kids don't just like it, they ask for it by color. When a child gets to choose, the crown becomes something they own rather than something that happened to them. That shift changes the whole appointment. Think of it like colored braces. Nobody hides braces anymore because kids turned them into a choice. Prismo works the same way. A kid who picked their color tends to show it off, and parents often notice they're brushing better at home too."
          }
        }
      ]
    }
    </script>
    {%- endif %}
    {{ content_for_header }}
  <style id="prismo-bigger-crowns">.crown-banner{height:560px!important}.crown-ticker{height:90px!important}</style>

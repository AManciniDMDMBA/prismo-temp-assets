      ar: 'نعم، نشحن إلى معظم دول العالم ومنها مصر ودول الخليج. الشحن الدولي بسعر ثابت 29.99 دولاراً أمريكياً لمعظم الوجهات، وتظهر عند الدفع خيارات الشحن السريع (DHL وUPS وFedEx). تُجهَّز الطلبات عادةً خلال 2 إلى 5 أيام عمل. قد تُطبَّق رسوم جمركية أو ضرائب استيراد حسب بلدك.',
      de: 'Ja, wir liefern in die meisten Länder, auch nach Deutschland, Österreich und in die Schweiz. Der internationale Versand kostet für die meisten Ziele pauschal 29,99 USD; an der Kasse sehen Sie außerdem Expressoptionen (DHL, UPS, FedEx). Bestellungen werden in der Regel innerhalb von 2 bis 5 Werktagen bearbeitet. Je nach Land können Einfuhrabgaben anfallen.',
      fr: 'Oui, nous livrons dans la plupart des pays, dont la France, la Belgique et la Suisse. La livraison internationale est à un tarif forfaitaire de 29,99 USD pour la plupart des destinations ; des options express (DHL, UPS, FedEx) sont proposées au paiement. Les commandes sont généralement préparées sous 2 à 5 jours ouvrés. Selon votre pays, des droits ou taxes d’importation peuvent s’appliquer.',
      pt: 'Sim, enviamos para a maioria dos países, incluindo Portugal e Brasil. O envio internacional tem uma tarifa fixa de 29,99 USD para a maioria dos destinos, e no pagamento também aparecem opções expresso (DHL, UPS, FedEx). Os pedidos são normalmente preparados em 2 a 5 dias úteis. Dependendo do seu país, podem aplicar-se taxas de importação.'
    };
    function mentionedCountry(txt) {
      var q = ' ' + txt.toLowerCase() + ' ', list = P.countries || [];
      for (var i = 0; i < list.length; i++) {
        var n = list[i].toLowerCase();
        if (n.length > 3 && q.indexOf(n) !== -1) return list[i];
      }
      return null;
    }
    function shipAnswer(txt) {
      var l = lang(txt), c = mentionedCountry(txt);
      if (SHIP[l]) return SHIP[l];
      if (c && c !== 'United States') {
        return 'Yes, we ship to ' + c + '. International shipping is a flat rate of US$29.99 for most countries, and faster carrier options (DHL, UPS, FedEx) are shown at checkout. Orders typically process within 2–5 business days. Import duties or taxes may apply depending on your country.';
      }
      return 'We ship throughout the US and to most countries worldwide. International shipping is a flat rate of US$29.99 for most countries, with faster carrier options (DHL, UPS, FedEx) shown at checkout; US rates are shown at checkout too. Orders typically process within 2–5 business days. Enter your address at checkout to confirm your country, or email prismocrowns@prismocrowns.com.';
    }
    var NOT_PRICE_RX = /(discount|promo|coupon|\bdeals?\b|on sale|price match|special offer|savings|my (child|kid|son|daughter))/i;
    var PRICE_RX = /(\bprices?\b|\bpricing\b|price ?list|how much|\bcosts?\b|\bquote\b|us dollars?|\busd\b|\bdollars?\b|\bcurrency\b|\bprecios?\b|cu[aá]nto (cuesta|cuestan|vale|valen|es|son)|\bcosto\b|\bcoste\b|d[oó]lares|\bmoneda\b|\bpreise?\b|\bkostet\b|\bkosten\b|\bprix\b|co[uû]tent?\b|\bcombien\b|\bpre[cç]os?\b|quanto custa|سعر|أسعار|اسعار|بكم|تكلفة|ثمن)/i;
    var SHIP_RX = /(\bship(s|ping|ped)?\b|\bdeliver(y|ies|s)?\b|\binternational\b|\bcountry\b|\bcustoms\b|\bdut(y|ies)\b|\benv[ií]os?\b|\benv[ií]an\b|\benviar\b|\benviam\b|\bentrega\b|\bversand\b|\bliefer\w*|\blivr\w*|\bexp[ée]di\w*|شحن|توصيل|تشحن)/i;
    var SAMPLES_RX = /(\bsamples?\b|\bfree (crowns?|trial)\b|\btry (it|them|one|before)\b|lunch (and|&|n|'n') learns?|\bdemos?\b|\bmuestras?\b|\bamostras?\b|[ée]chantillons?|\bmuster\b|\bproben?\b|عين[ةه]|عينات|عيّنة)/i;
    var SIZING_ML_RX = /(\bgr[oö][sß]en?\b|\btama[ñn]os?\b|\btallas?\b|\bmedidas?\b|\btailles?\b|\btamanhos?\b|مقاس|مقاسات|حجم)/i;
    var ORDER_ML_RX = /(\bbestell\w*|\bkaufen\b|\bcomprar\b|\bpedir\b|\bpedidos?\b|\bcommander\b|\bcommande\b|\bacheter\b|\bencomendar\b|\bencomenda\b|أطلب|اطلب|شراء|أشتري|الطلب)/i;
    var COLOR_ML_RX = /(\bsicher\w*|\bfarben?\b|\bseguro\b|\bsegura\b|\bcolor(es)?\b|\bcouleurs?\b|\bs[ûu]r\b|\bcor(es)?\b|آمن|آمنة|لون|ألوان|الوان)/i;

    /* ── Common English questions (from chat transcripts, Jul–Nov 2026) ── */
    var BILLING_A = 'Prismo Crowns are billed under the same CDT code as traditional stainless steel crowns (D2930 for a prefabricated stainless steel crown on a primary tooth), with no separate code for color. If silver is covered, Prismo is covered too, including Medicaid. Coverage depends on the plan, so it is worth confirming with the insurer.';
    var TOPICS = [
      { rx: SAMPLES_RX, a: function () { return T.samples.en; } },
      { rx: /\b(insurance|medicaid|medicad|cdt|billing|bill(ed|s)?|dental codes?|special (dental )?codes?|reimburs\w*|d2930)\b/i, a: function () { return BILLING_A; } },
      { rx: /\b(pamphlets?|brochures?|broshures?|flyers?|posters?|handouts?|leaflets?|marketing materials?|patient education)\b/i, a: function () { return 'Yes, we have a patient poster and a parent brochure you can use in your office. Tap Send a Message or email prismocrowns@prismocrowns.com with your practice name and our team will send them over.'; } },
      { rx: /\b(anterior|front teeth|incisors?|canines?|adults?|permanent (teeth|tooth|molars?)|primary molars?|(first|1st) (and|or|&) (second|2nd)|which teeth|posterior)\b/i, a: function () { return 'Prismo Crowns are pediatric stainless steel crowns for primary molars: first and second primary molars, upper and lower, in sizes 2–7. We don\'t currently offer anterior crowns or crowns for permanent (adult) teeth.'; } },
      { rx: /(\bare (these|they|those|the crowns|your crowns)\b[\s\S]{0,25}\b(stainless|steel|metal)\b|\bwhat (are they|is it|are these) made\b|\bmade (of|from)\b|\bmaterials?\b|\bnickel\b|\bnic\w{0,2}le\b|\balloy\b|\b316l?\b|\bwhat grade\b|\bsteel grade\b)/i, a: function () { return 'Yes, Prismo Crowns are surgical-grade 300-series stainless steel, the same family of alloy used in traditional pediatric stainless steel crowns. The color comes from a patented laser-assisted process with no dye, paint or coating. For detailed alloy composition, such as nickel content, email prismocrowns@prismocrowns.com and our team will send the specifics.'; } },
      { rx: PRICE_RX, not: NOT_PRICE_RX, a: priceAnswer },
      { rx: SHIP_RX, a: shipAnswer }
    ];
    function topicAnswers(txt, max) {
      var out = [];
      for (var i = 0; i < TOPICS.length && out.length < max; i++) {
        var t = TOPICS[i];
        if (t.rx.test(txt) && !(t.not && t.not.test(txt))) { var a = t.a(txt); if (a) out.push(a); }
      }
      return out;
    }
    /* Non-English messages: answer in the visitor's language */
    function foreignAnswer(txt, l) {
      if (SAMPLES_RX.test(txt)) return T.samples[l];
      if (PRICE_RX.test(txt)) { var pa = priceAnswer(txt); if (pa) return pa; }
      if (SHIP_RX.test(txt)) return shipAnswer(txt);
      if (SIZING_ML_RX.test(txt) || /\b3\s*m\b/i.test(txt)) return T.sizing[l];
      if (COLOR_ML_RX.test(txt)) return T.color[l];
      if (ORDER_ML_RX.test(txt)) return T.order[l];
      return T.fallback[l];
    }
    var PARENT_RX = /\b(my (child|kid|kids|son|daughter|baby|little)|parents?|mom|dad|mother|father|toddler)\b/i;
    var FAMILY_REPLY = 'not directly to families';
    var SIZING_REPLY = 'Sizing is one of the easiest parts of switching';

    function answerFor(txt, original) {
      var l = lang(txt);
      if (l !== 'en') return foreignAnswer(txt, l);
      for (var i = 0; i < RULES.length; i++) {
        if (RULES[i].rx.test(txt)) return RULES[i].a;
      }
      var sizing = !!original && original.indexOf(SIZING_REPLY) !== -1;
      var topics = topicAnswers(txt, sizing ? 1 : 2);
      if (sizing) {
        if (!topics.length) return null;
        /* "3M" mentioned in passing: answer what was actually asked */
        if (!/\b(siz\w*|fit(s|ting|ment)?|comparab\w*|compatib\w*)\b/i.test(txt)) return topicAnswers(txt, 2).join(' ');
        return original + ' ' + topics[0];
      }
      if (topics.length) return topics.join(' ');
      /* The "we sell to practices, not families" reply is only right for parents */
      if (original && original.indexOf(FAMILY_REPLY) !== -1 && !PARENT_RX.test(txt)) {
        if (/(order(ed|s)?|bought|purchas\w*|deliver\w*|shipment|package|box)/i.test(txt)) return ORDER_HELP;
        return 'Dental practices can order directly at prismocrowns.com: head to the Shop section for the Intro Kit, Pro Kit, and refill packs. For help with an existing order, email prismocrowns@prismocrowns.com with your order number.';
      }
      return null;
    }

    function lastUserText(msgs) {
      var users = msgs.querySelectorAll('.chat-msg.user .chat-bubble');
      return users.length ? users[users.length - 1].textContent.trim() : '';
    }

    function fixReply(msgs, bubble) {
      if (!bubble || bubble.getAttribute('data-prismo-routed')) return;
      bubble.setAttribute('data-prismo-routed', '1');
      var faqTail = bubble.querySelector('.chat-faq-tail');
      var tailHtml = faqTail ? faqTail.outerHTML : '';
      var origText = bubble.textContent;
      if (faqTail) origText = origText.replace(faqTail.textContent, '').trim();
      var answer = answerFor(lastUserText(msgs), origText);
      if (answer) {
        bubble.innerHTML = answer + tailHtml;
        return;
      }
      if (bubble.innerHTML.indexOf('best per-crown value') !== -1) {
        bubble.innerHTML = bubble.innerHTML
          .replace('For the best per-crown value, the Pro Kit (240 crowns) is the way to go.', 'For volume or practice-group pricing, email prismocrowns@prismocrowns.com and our team will put together a quote.')
          .replace('for the best per-crown value.', 'for a complete set.');
      }
    }

    /* Keep the transcript email in sync with what the visitor saw: rewrite the AI lines of
       the "NEW AI CHAT SESSION" body (built with URLSearchParams in mockup-homepage)
       using the same sizing / routing / wording corrections applied on screen. */
    var SIZING_RX = /\b(siz(e|es|ed|ing)|3\s*m|unitek|espe|hu[\s.-]?friedy|hufriedy|comparab\w*|compatib\w*|equivalen\w*|interchang\w*|fits?|fitment|dimensions?|conversion|crossover)\b/i;
    var SIZING_TEXT = 'Sizing is one of the easiest parts of switching. Prismo Crowns come in standard pediatric sizes 2–7 and follow the same universal stainless steel crown sizing you already use — comparable to 3M stainless steel crown sizing, so the size you place today is the size you pick with Prismo. Providers have also shared that the fit lines up with Hu-Friedy sizing. Same chairside trial-and-fit, no conversion chart needed. The Intro Kit covers the most-used sizes (3, 4 & 5), and refill packs are available in every size 2–7.';
    function correctTranscript(body) {
      var lastVisitor = '';
      return body.split('\n').map(function (line) {
        var v = line.match(/^\[[^\]]*\] Visitor: (.*)$/);
        if (v) { lastVisitor = v[1]; return line; }
        var a = line.match(/^(\[[^\]]*\] AI: )(.*)$/);
        if (!a || !lastVisitor) return line;
        var orig = (SIZING_RX.test(lastVisitor) && lang(lastVisitor) === 'en') ? SIZING_TEXT : a[2];
        var routed = answerFor(lastVisitor, orig);
        if (!routed && orig === SIZING_TEXT) return a[1] + SIZING_TEXT;
        if (routed) return a[1] + routed;
        return a[1] + a[2]
          .replace('For the best per-crown value, the Pro Kit (240 crowns) is the way to go.', 'For volume or practice-group pricing, email prismocrowns@prismocrowns.com and our team will put together a quote.')
          .replace('for the best per-crown value.', 'for a complete set.');
      }).join('\n');
    }
    var origAppend = URLSearchParams.prototype.append;
    URLSearchParams.prototype.append = function (name, value) {
      if (name === 'contact[body]' && typeof value === 'string' && value.indexOf('NEW AI CHAT SESSION') === 0) {
        try { value = correctTranscript(value); } catch (err) {}
      }
      return origAppend.call(this, name, value);
    };

    var tries = 0;
    function watchChat() {
      tries++;
      var msgs = document.getElementById('chatMessages');
      if (!msgs) {
        if (tries < 30) setTimeout(watchChat, 300);
        return;
      }
      new MutationObserver(function (muts) {
        muts.forEach(function (m) {
          for (var i = 0; i < m.addedNodes.length; i++) {
            var n = m.addedNodes[i];
            if (n.nodeType === 1 && n.classList.contains('chat-msg') && n.classList.contains('bot')) {
              var b = n.querySelector('.chat-bubble');
              if (b) setTimeout(function (bb) { return function () { fixReply(msgs, bb); }; }(b), 0);
            }
          }
        });
      }).observe(msgs, { childList: true });
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', watchChat);
    } else {
      watchChat();
    }
  })();
</script>

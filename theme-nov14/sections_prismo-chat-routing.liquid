{%- comment -%}
  Prismo Chat Routing — corrects the keyword matcher's reply for distributor, order-change,
  phone-number and how-to-order questions, and removes "best per-crown value" wording.
  Nov 14 2026: price questions answer with live local-currency prices and shipping questions
  with the international flat rate (English, Spanish, Arabic).
  Nov 2026: added single-color / custom kit requests and "can't add to cart / checkout" problems,
  which previously got the generic kit answer repeated.
  The original chat still handles every message, so the visitor's question stays in the
  transcript email; only the reply shown on screen is replaced.
{%- endcomment -%}
{%- liquid
  assign pc_intro = all_products['prismo-intro-kit']
  assign pc_pro = all_products['prismo-pro-kit-240-crowns']
  assign pc_refill = all_products['pack-of-5-colored-stainless-steel-dental-crowns-gold']
  assign pc_intro_each = pc_intro.price | divided_by: 48
  assign pc_pro_each = pc_pro.price | divided_by: 240
  assign pc_refill_pack = pc_refill.variants.first.price
  assign pc_refill_each = pc_refill_pack | divided_by: 5
-%}
<script>
  /* Live prices for the chat, in the visitor's currency (Shopify Markets). Nov 14 2026. */
  window.PRISMO_CHAT_PRICES = {
    ok: {% if pc_intro.id and pc_pro.id and pc_refill.id %}true{% else %}false{% endif %},
    currency: {{ cart.currency.iso_code | json }},
    country: {{ localization.country.name | json }},
    introTotal: {{ pc_intro.price | money | strip_html | json }},
    introEach: {{ pc_intro_each | money | strip_html | json }},
    proTotal: {{ pc_pro.price | money | strip_html | json }},
    proEach: {{ pc_pro_each | money | strip_html | json }},
    refillPack: {{ pc_refill_pack | money | strip_html | json }},
    refillEach: {{ pc_refill_each | money | strip_html | json }},
    countries: [{% for c in localization.available_countries %}{{ c.name | json }}{% unless forloop.last %},{% endunless %}{% endfor %}]
  };
</script>
<script>
  (function () {
    var RULES = [
      { rx: /(\b(unicorn|gold|blue|purple|sapphire|single[- ]?colou?r|one colou?r|same colou?r|custom\w*)\b[\s\S]{0,40}\bkits?\b|\bkits?\b[\s\S]{0,40}\b(unicorn|gold|blue|purple|sapphire|single[- ]?colou?r|one colou?r|custom\w*)\b|all (unicorn|gold|blue|purple))/i,
        a: 'On the website our Intro Kit and Pro Kit ship in assorted colors, but we can put together single-color kits (for example, all Unicorn) for your practice. Tap Send a Message or email prismocrowns@prismocrowns.com with the kit, color and quantity you need, and our team will send you a checkout link within one business day.' },
      { rx: /((won'?t|will not|doesn'?t|does not|not) let|can'?t|cannot|unable to|not able to|isn'?t working|not working|error|problem|issue)[\s\S]{0,40}\b(order|add|cart|checkout|check out|buy|purchase|pay)/i,
        a: 'Sorry about that! Tap Send a Message (or email prismocrowns@prismocrowns.com) with what you are trying to order and your practice name, and our team will send you a direct checkout link within one business day.' },
      { rx: /\b(distribut\w*|wholesale|resell\w*|dealers?|dealership|partnership|partner with|authorized agent|become an agent|sales agent|exclusive|importer|importing)\b/i,
        a: 'Thanks for your interest in partnering with Prismo! Please email prismocrowns@prismocrowns.com with your company name, region, and a short introduction, and our team will follow up with you personally.' },
      { rx: /(change (my|our|the) order|change it|can (we|i) change|\b(we|i) ordered\b|wrong kit|\bmy order\b|order (status|number)|\btracking\b|track my|where is my|\bcancel\w*|\bmodify\b|\bupgrade\b|\bswitch\b)/i,
        a: 'Happy to help with your order! Please email prismocrowns@prismocrowns.com with your order number and what you would like to change, and our team will take care of it within one business day.' },
      { rx: /\bnumber\b/i,
        a: 'You can reach our team at prismocrowns@prismocrowns.com, or use the Send a Message option and we will reply within one business day.' },
      { rx: /(how (do|can) (i|we) (place an |make an )?order|place an order|order online)/i,
        a: 'Dental practices can order directly at prismocrowns.com — head to the Shop section for the Intro Kit, Pro Kit, and refill packs. Checkout takes about a minute.' }
    ];

    /* ── Prices and international shipping (English, Spanish, Arabic) ── */
    var P = window.PRISMO_CHAT_PRICES || {};
    function lang(txt) {
      if (/[؀-ۿ]/.test(txt)) return 'ar';
      if (/[¿¡ñ]|\b(precio|precios|cu[aá]nto|cuesta|cuestan|costo|coste|env[ií]o|env[ií]an|enviar|hacen|pa[ií]s|d[oó]lares|moneda|hola|gracias|coronas)\b/i.test(txt)) return 'es';
      return 'en';
    }
    function priceAnswer(txt) {
      if (!P.ok) return null;
      var usd = P.currency === 'USD', l = lang(txt);
      if (l === 'es') {
        return 'Estos son nuestros precios actuales' + (usd ? ' en dólares estadounidenses (USD)' : ' en ' + P.currency) + ': ' +
          'Intro Kit (48 coronas, tamaños 3, 4 y 5): ' + P.introTotal + ' (' + P.introEach + ' por corona). ' +
          'Pro Kit (240 coronas, todos los tamaños y colores): ' + P.proTotal + ' (' + P.proEach + ' por corona). ' +
          'Refill Pack (5 coronas de un tamaño y color): desde ' + P.refillPack + ' (' + P.refillEach + ' por corona). ' +
          (usd ? '' : 'Los precios se convierten desde dólares estadounidenses al tipo de cambio del día y el importe final se confirma al pagar. ') +
          'El precio para el paciente lo fija su dentista.';
      }
      if (l === 'ar') {
        return 'هذه أسعارنا الحالية' + (usd ? ' بالدولار الأمريكي (USD)' : ' بعملة ' + P.currency) + ': ' +
          'المجموعة التمهيدية Intro Kit (48 تاجاً، المقاسات 3 و4 و5): ' + P.introTotal + ' (' + P.introEach + ' للتاج الواحد). ' +
          'مجموعة Pro Kit (240 تاجاً، جميع المقاسات والألوان): ' + P.proTotal + ' (' + P.proEach + ' للتاج الواحد). ' +
          'عبوة إعادة التعبئة Refill Pack (5 تيجان بمقاس ولون واحد): ابتداءً من ' + P.refillPack + ' (' + P.refillEach + ' للتاج الواحد). ' +
          (usd ? '' : 'الأسعار محوّلة من الدولار الأمريكي بسعر الصرف اليومي، ويُؤكَّد المبلغ النهائي عند الدفع. ') +
          'سعر المريض يحدده طبيب الأسنان.';
      }
      return 'Here is our current pricing' + (usd ? ' in US dollars (USD)' : ' in ' + P.currency + (P.country ? ' for ' + P.country : '')) + ': ' +
        'Intro Kit (48 crowns, sizes 3, 4 & 5): ' + P.introTotal + ' (' + P.introEach + ' per crown). ' +
        'Pro Kit (240 crowns, all sizes and colors): ' + P.proTotal + ' (' + P.proEach + ' per crown). ' +
        'Refill Pack (5 crowns of one size and color): from ' + P.refillPack + ' (' + P.refillEach + ' per crown). ' +
        (usd ? '' : 'Prices are converted from US dollars at the current exchange rate, and the final amount is confirmed at checkout. ') +
        'Patient pricing is set by your dentist.';
    }
    function mentionedCountry(txt) {
      var q = ' ' + txt.toLowerCase() + ' ', list = P.countries || [];
      for (var i = 0; i < list.length; i++) {
        var n = list[i].toLowerCase();
        if (n.length > 3 && q.indexOf(n) !== -1) return list[i];
      }
      return null;
    }
    function shipAnswer(txt) {
      var l = lang(txt), c = mentionedCountry(txt);
      if (l === 'es') {
        return 'Sí, enviamos a la mayoría de los países, incluidos España y gran parte de Latinoamérica. El envío internacional tiene una tarifa fija de 29,99 USD para la mayoría de los destinos, y al pagar también verá opciones exprés (DHL, UPS, FedEx). Los pedidos se preparan normalmente en 2 a 5 días hábiles. Introduzca su dirección al pagar para confirmar su país, o escríbanos a prismocrowns@prismocrowns.com.';
      }
      if (l === 'ar') {
        return 'نعم، نشحن إلى معظم دول العالم ومنها مصر ودول الخليج. الشحن الدولي بسعر ثابت 29.99 دولاراً أمريكياً لمعظم الوجهات، وتظهر عند الدفع خيارات الشحن السريع (DHL وUPS وFedEx). تُجهَّز الطلبات عادةً خلال 2 إلى 5 أيام عمل. أدخل عنوانك عند الدفع لتأكيد بلدك، أو راسلنا على prismocrowns@prismocrowns.com.';
      }
      if (c && c !== 'United States') {
        return 'Yes, we ship to ' + c + '. International shipping is a flat rate of US$29.99 for most countries, and faster carrier options (DHL, UPS, FedEx) are shown at checkout. Orders typically process within 2–5 business days. Import duties or taxes, if your country charges them, are paid by the recipient.';
      }
      return 'We ship throughout the US and to most countries worldwide. International shipping is a flat rate of US$29.99 for most countries, with faster carrier options (DHL, UPS, FedEx) shown at checkout; US rates are shown at checkout too. Orders typically process within 2–5 business days. Enter your address at checkout to confirm your country, or email prismocrowns@prismocrowns.com.';
    }
    var NOT_PRICE_RX = /(discount|promo|coupon|\bdeals?\b|on sale|price match|special offer|savings|sample|insurance|medicaid|refund|my (child|kid|son|daughter))/i;
    var PRICE_RX = /(\bprices?\b|\bpricing\b|price ?list|how much|\bcosts?\b|\bquote\b|us dollars?|\busd\b|\bdollars?\b|\bcurrency\b|\bprecios?\b|cu[aá]nto (cuesta|cuestan|vale|valen|es|son)|\bcosto\b|\bcoste\b|d[oó]lares|\bmoneda\b|سعر|أسعار|اسعار|بكم|كم (سعر|ثمن|تكلفة)|تكلفة|ثمن)/i;
    var SHIP_RX = /(\bship(s|ping|ped)?\b|\bdeliver(y|ies|s)?\b|\binternational\b|\bcountry\b|\bcustoms\b|\bdut(y|ies)\b|\benv[ií]os?\b|\benv[ií]an\b|\benviar\b|\bentrega\b|شحن|توصيل|تشحن)/i;
    var SIZING_REPLY = 'Sizing is one of the easiest parts of switching';

    function answerFor(txt) {
      for (var i = 0; i < RULES.length; i++) {
        if (RULES[i].rx.test(txt)) return RULES[i].a;
      }
      /* Checked after the order / distributor / checkout-problem rules above */
      if (PRICE_RX.test(txt) && !NOT_PRICE_RX.test(txt)) { var pa = priceAnswer(txt); if (pa) return pa; }
      if (SHIP_RX.test(txt)) return shipAnswer(txt);
      return null;
    }

    function lastUserText(msgs) {
      var users = msgs.querySelectorAll('.chat-msg.user .chat-bubble');
      return users.length ? users[users.length - 1].textContent.trim() : '';
    }

    function fixReply(msgs, bubble) {
      if (!bubble || bubble.getAttribute('data-prismo-routed')) return;
      bubble.setAttribute('data-prismo-routed', '1');
      if (bubble.textContent.indexOf(SIZING_REPLY) !== -1) return;
      var faqTail = bubble.querySelector('.chat-faq-tail');
      var tailHtml = faqTail ? faqTail.outerHTML : '';
      var answer = answerFor(lastUserText(msgs));
      if (answer) {
        bubble.innerHTML = answer + tailHtml;
        return;
      }
      if (bubble.innerHTML.indexOf('best per-crown value') !== -1) {
        bubble.innerHTML = bubble.innerHTML
          .replace('For the best per-crown value, the Pro Kit (240 crowns) is the way to go.', 'For volume or practice-group pricing, email prismocrowns@prismocrowns.com and our team will put together a quote.')
          .replace('for the best per-crown value.', 'for a complete set.');
      }
    }

    /* Keep the transcript email in sync with what the visitor saw: rewrite the AI lines of
       the "NEW AI CHAT SESSION" body (built with URLSearchParams in mockup-homepage)
       using the same sizing / routing / wording corrections applied on screen. */
    var SIZING_RX = /\b(siz(e|es|ed|ing)|3\s*m|unitek|espe|hu[\s.-]?friedy|hufriedy|comparab\w*|compatib\w*|equivalen\w*|interchang\w*|fits?|fitment|dimensions?|conversion|crossover)\b/i;
    var SIZING_TEXT = 'Sizing is one of the easiest parts of switching. Prismo Crowns come in standard pediatric sizes 2–7 and follow the same universal stainless steel crown sizing you already use — comparable to 3M stainless steel crown sizing, so the size you place today is the size you pick with Prismo. Providers have also shared that the fit lines up with Hu-Friedy sizing. Same chairside trial-and-fit, no conversion chart needed. The Intro Kit covers the most-used sizes (3, 4 & 5), and refill packs are available in every size 2–7.';
    function correctTranscript(body) {
      var lastVisitor = '';
      return body.split('\n').map(function (line) {
        var v = line.match(/^\[[^\]]*\] Visitor: (.*)$/);
        if (v) { lastVisitor = v[1]; return line; }
        var a = line.match(/^(\[[^\]]*\] AI: )(.*)$/);
        if (!a || !lastVisitor) return line;
        if (SIZING_RX.test(lastVisitor)) return a[1] + SIZING_TEXT;
        var routed = answerFor(lastVisitor);
        if (routed) return a[1] + routed;
        return a[1] + a[2]
          .replace('For the best per-crown value, the Pro Kit (240 crowns) is the way to go.', 'For volume or practice-group pricing, email prismocrowns@prismocrowns.com and our team will put together a quote.')
          .replace('for the best per-crown value.', 'for a complete set.');
      }).join('\n');
    }
    var origAppend = URLSearchParams.prototype.append;
    URLSearchParams.prototype.append = function (name, value) {
      if (name === 'contact[body]' && typeof value === 'string' && value.indexOf('NEW AI CHAT SESSION') === 0) {
        try { value = correctTranscript(value); } catch (err) {}
      }
      return origAppend.call(this, name, value);
    };

    var tries = 0;
    function watchChat() {
      tries++;
      var msgs = document.getElementById('chatMessages');
      if (!msgs) {
        if (tries < 30) setTimeout(watchChat, 300);
        return;
      }
      new MutationObserver(function (muts) {
        muts.forEach(function (m) {
          for (var i = 0; i < m.addedNodes.length; i++) {
            var n = m.addedNodes[i];
            if (n.nodeType === 1 && n.classList.contains('chat-msg') && n.classList.contains('bot')) {
              var b = n.querySelector('.chat-bubble');
              if (b) setTimeout(function (bb) { return function () { fixReply(msgs, bb); }; }(b), 0);
            }
          }
        });
      }).observe(msgs, { childList: true });
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', watchChat);
    } else {
      watchChat();
    }
  })();
</script>
{% schema %}
{
  "name": "Prismo Chat Routing",
  "settings": []
}
{% endschema %}

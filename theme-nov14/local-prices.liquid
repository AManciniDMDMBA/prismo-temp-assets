{%- comment -%}
  Prismo Local Prices — shows the per-crown prices on the homepage kit cards
  and in the FAQ in the visitor's local currency instead of hard-coded USD.
  Prices come from snippets/prismo-per-crown-price (kit price / crown count),
  so they match the product page and checkout. Patches the static
  mockup-homepage and prismo-global-modals markup on load, like the other
  prismo-* patches. US visitors see no change.
{%- endcomment -%}
{%- capture intro_each -%}{% render 'prismo-per-crown-price', kit: 'intro' %}{%- endcapture -%}
{%- capture pro_each -%}{% render 'prismo-per-crown-price', kit: 'pro' %}{%- endcapture -%}
{%- capture refill_each -%}{% render 'prismo-per-crown-price', kit: 'refill' %}{%- endcapture -%}
<script>
(function () {
  if (window.__prismoLocalPrices) return;
  window.__prismoLocalPrices = true;
  function decode(s) {
    var t = document.createElement('textarea');
    t.innerHTML = s;
    return t.value;
  }
  // [hard-coded USD text, local-currency price]
  var swaps = [
    ['$10.99 ea.', decode({{ intro_each | strip_html | json }}) + ' ea.'],
    ['$9.99 ea.', decode({{ pro_each | strip_html | json }}) + ' ea.'],
    ['$8.99 ea.', decode({{ refill_each | strip_html | json }}) + ' ea.'],
    /* product descriptions end with "($10.99 each)" */
    ['$10.99 each', decode({{ intro_each | strip_html | json }}) + ' each'],
    ['$9.99 each', decode({{ pro_each | strip_html | json }}) + ' each'],
    ['$8.99 each', decode({{ refill_each | strip_html | json }}) + ' each']
  ].filter(function (s) { return s[0] !== s[1]; });
  if (!swaps.length) return;

  function patch() {
    var roots = document.querySelectorAll('.kits-section, #faqModal, .product__description');
    roots.forEach(function (root) {
      var walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
      var node;
      while ((node = walker.nextNode())) {
        var text = node.nodeValue;
        if (text.indexOf('$') === -1) continue;
        swaps.forEach(function (s) { text = text.split(s[0]).join(s[1]); });
        if (text !== node.nodeValue) node.nodeValue = text;
      }
    });
    return roots.length > 0;
  }

  var tries = 0;
  function run() {
    tries++;
    if (!patch() && tries < 20) setTimeout(run, 250);
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', run);
  } else {
    run();
  }
})();
</script>

{% schema %}
{
  "name": "Prismo Local Prices",
  "settings": []
}
{% endschema %}

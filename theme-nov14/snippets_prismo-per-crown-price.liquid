{%- comment -%}
  Per-crown price in the visitor's local currency (Shopify Markets).

  Usage: {% render 'prismo-per-crown-price', kit: 'intro' %}
    kit: 'intro'  -> Intro Kit price / 48
         'pro'    -> Pro Kit price / 240
         'refill' -> one 5-crown refill pack / 5

  Divides the kit's real product price (already converted by Shopify for the
  visitor's market) by its crown count, so the number always matches the
  product page and checkout. Falls back to the USD list price if the product
  can't be found.
{%- endcomment -%}
{%- liquid
  assign crowns = 1
  assign cents = 0
  case kit
    when 'intro'
      assign p = all_products['prismo-intro-kit']
      assign crowns = 48
      assign fallback = '$10.99'
    when 'pro'
      assign p = all_products['prismo-pro-kit-240-crowns']
      assign crowns = 240
      assign fallback = '$9.99'
    when 'refill'
      assign p = all_products['pack-of-5-colored-stainless-steel-dental-crowns-gold']
      assign crowns = 5
      assign fallback = '$8.99'
  endcase

  if p.id
    if kit == 'refill'
      assign cents = p.variants.first.price
    else
      assign cents = p.price
    endif
  endif

  if cents > 0
    assign each = cents | divided_by: crowns
    echo each | money
  else
    echo fallback
  endif
-%}
